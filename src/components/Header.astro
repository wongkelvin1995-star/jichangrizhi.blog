<script>
  import { searchSite } from '../lib/search-engine.ts';

  let searchIndexCache: any[] | null = null;

  async function getSearchIndex() {
    if (searchIndexCache) return searchIndexCache;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) {
        searchIndexCache = await res.json();
        return searchIndexCache;
      }
    } catch (e) {
      console.warn('Failed to load search-index.json via fetch, trying window index', e);
    }
    return (window as any).__SEARCH_INDEX__ || [];
  }

  // Desktop Search
  const navSearchInput = document.getElementById('navQuickSearchInput') as HTMLInputElement | null;
  const navDropdown = document.getElementById('navSearchDropdown');
  const navResultsBody = document.getElementById('navSearchResultsBody');
  const navViewAll = document.getElementById('navViewAllSearchLink') as HTMLAnchorElement | null;
  const searchWrapper = document.getElementById('headerSearchWrapper');

  let selectedIndex = -1;
  let currentResultLinks: HTMLElement[] = [];
  let navDebounce: any = null;

  async function handleNavSearch(query: string) {
    const q = query.trim();
    if (!q) {
      if (navDropdown) navDropdown.style.display = 'none';
      return;
    }

    const index = await getSearchIndex();
    const grouped = searchSite(index, q);

    if (navViewAll) {
      navViewAll.href = `/search/?q=${encodeURIComponent(q)}`;
      navViewAll.innerText = `在搜索页查看全部 ${grouped.total} 条结果 →`;
    }

    if (!navResultsBody || !navDropdown) return;

    if (grouped.total === 0) {
      navResultsBody.innerHTML = `
        <div style="padding: 24px 16px; text-align: center; color: #65738C; font-size: 0.88rem;">
          暂未找到 “${q}” 的相关内容<br>
          <a href="/search/?q=${encodeURIComponent(q)}" style="color: #285CF0; font-weight: 700; margin-top: 8px; display: inline-block;">进入搜索页查看建议 →</a>
        </div>
      `;
      navDropdown.style.display = 'flex';
      return;
    }

    let html = '';

    // Render by Categories (Top 3 of each)
    if (grouped.brands.length > 0) {
      html += `<div class="result-group-label">机场品牌 (${grouped.brands.length})</div>`;
      grouped.brands.slice(0, 3).forEach(r => {
        html += renderResultRow(r);
      });
    }

    if (grouped.plans.length > 0) {
      html += `<div class="result-group-label">机场套餐 (${grouped.plans.length})</div>`;
      grouped.plans.slice(0, 3).forEach(r => {
        html += renderResultRow(r);
      });
    }

    if (grouped.guides.length > 0) {
      html += `<div class="result-group-label">使用指南 (${grouped.guides.length})</div>`;
      grouped.guides.slice(0, 2).forEach(r => {
        html += renderResultRow(r);
      });
    }

    if (grouped.articles.length > 0) {
      html += `<div class="result-group-label">专题文章 (${grouped.articles.length})</div>`;
      grouped.articles.slice(0, 2).forEach(r => {
        html += renderResultRow(r);
      });
    }

    if (grouped.risks.length > 0) {
      html += `<div class="result-group-label">风险预警 (${grouped.risks.length})</div>`;
      grouped.risks.slice(0, 2).forEach(r => {
        html += renderResultRow(r);
      });
    }

    navResultsBody.innerHTML = html;
    navDropdown.style.display = 'flex';
    selectedIndex = -1;
    currentResultLinks = Array.from(navResultsBody.querySelectorAll('.result-item-link'));
  }

  function renderResultRow(r: any) {
    const item = r.item;
    const badge = item.price || item.badge || item.typeName;
    return `
      <a href="${item.url}" class="result-item-link" data-url="${item.url}">
        <div class="result-item-left">
          <span class="result-item-title">${r.highlightedTitle}</span>
          <span class="result-item-snippet">${r.highlightedSnippet}</span>
        </div>
        <span class="result-item-badge">${badge}</span>
      </a>
    `;
  }

  if (navSearchInput) {
    navSearchInput.addEventListener('input', () => {
      clearTimeout(navDebounce);
      navDebounce = setTimeout(() => {
        handleNavSearch(navSearchInput.value);
      }, 150);
    });

    navSearchInput.addEventListener('focus', () => {
      if (navSearchInput.value.trim()) {
        handleNavSearch(navSearchInput.value);
      }
    });

    // Keyboard Navigation: Up, Down, Enter, Escape
    navSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (currentResultLinks.length > 0) {
          selectedIndex = (selectedIndex + 1) % currentResultLinks.length;
          updateSelectedRow();
        }
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (currentResultLinks.length > 0) {
          selectedIndex = (selectedIndex - 1 + currentResultLinks.length) % currentResultLinks.length;
          updateSelectedRow();
        }
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (selectedIndex >= 0 && selectedIndex < currentResultLinks.length) {
          currentResultLinks[selectedIndex].click();
        } else if (navSearchInput.value.trim()) {
          window.location.href = `/search/?q=${encodeURIComponent(navSearchInput.value.trim())}`;
        }
      } else if (e.key === 'Escape') {
        if (navDropdown) navDropdown.style.display = 'none';
      }
    });
  }

  function updateSelectedRow() {
    currentResultLinks.forEach((link, idx) => {
      if (idx === selectedIndex) {
        link.classList.add('selected');
        link.scrollIntoView({ block: 'nearest' });
      } else {
        link.classList.remove('selected');
      }
    });
  }

  // Click outside to close
  document.addEventListener('click', (e) => {
    if (searchWrapper && !searchWrapper.contains(e.target as Node)) {
      if (navDropdown) navDropdown.style.display = 'none';
    }
  });

  // Global "/" key shortcut to focus search
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT' && document.activeElement?.tagName !== 'TEXTAREA') {
      e.preventDefault();
      if (navSearchInput) {
        navSearchInput.focus();
        navSearchInput.select();
      }
    }
  });

  // Mobile Search Toggle
  const mobileSearchBtn = document.getElementById('mobileSearchBtn');
  const mobileSearchBar = document.getElementById('mobileSearchBar');
  const closeMobileSearchBtn = document.getElementById('closeMobileSearchBtn');
  const mobileSearchInput = document.getElementById('mobileSearchInput') as HTMLInputElement | null;
  const mobileDropdown = document.getElementById('mobileSearchDropdown');
  const mobileResultsBody = document.getElementById('mobileSearchResultsBody');

  if (mobileSearchBtn && mobileSearchBar) {
    mobileSearchBtn.addEventListener('click', () => {
      mobileSearchBar.style.display = 'block';
      if (mobileSearchInput) mobileSearchInput.focus();
    });
  }

  if (closeMobileSearchBtn && mobileSearchBar) {
    closeMobileSearchBtn.addEventListener('click', () => {
      mobileSearchBar.style.display = 'none';
      if (mobileDropdown) mobileDropdown.style.display = 'none';
    });
  }

  if (mobileSearchInput && mobileDropdown && mobileResultsBody) {
    let mobileDebounce: any = null;
    mobileSearchInput.addEventListener('input', () => {
      clearTimeout(mobileDebounce);
      mobileDebounce = setTimeout(async () => {
        const q = mobileSearchInput.value.trim();
        if (!q) {
          mobileDropdown.style.display = 'none';
          return;
        }
        const index = await getSearchIndex();
        const grouped = searchSite(index, q);
        if (grouped.total === 0) {
          mobileResultsBody.innerHTML = `
            <div style="padding: 16px; text-align: center; color: #65738C; font-size: 0.88rem;">
              暂无匹配结果，<a href="/search/?q=${encodeURIComponent(q)}" style="color: #285CF0; font-weight: 700;">去搜索页 →</a>
            </div>
          `;
        } else {
          let html = '';
          grouped.all.slice(0, 8).forEach(r => {
            html += renderResultRow(r);
          });
          html += `
            <div style="padding: 10px; text-align: center;">
              <a href="/search/?q=${encodeURIComponent(q)}" style="color: #285CF0; font-weight: 700; font-size: 0.86rem;">
                查看全部 ${grouped.total} 条结果 →
              </a>
            </div>
          `;
          mobileResultsBody.innerHTML = html;
        }
        mobileDropdown.style.display = 'block';
      }, 150);
    });

    mobileSearchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && mobileSearchInput.value.trim()) {
        window.location.href = `/search/?q=${encodeURIComponent(mobileSearchInput.value.trim())}`;
      }
    });
  }

  // Mobile Drawer Toggle
  const menuBtn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');
  if (menuBtn && drawer) {
    menuBtn.addEventListener('click', () => {
      const isOpen = drawer.classList.contains('open');
      drawer.classList.toggle('open');
      menuBtn.setAttribute('aria-expanded', String(!isOpen));
    });

    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        drawer.classList.remove('open');
        menuBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
  // Update Personal Center Badge Dot based on unread notifications
  import { UserStore } from '../lib/user-store.ts';
  const badgeDot = document.getElementById('headerPersonalBadgeDot');
  function updateHeaderBadge() {
    if (!badgeDot) return;
    const counts = UserStore.getCounts();
    badgeDot.style.display = counts.unreadNotifs > 0 ? 'block' : 'none';
  }
  updateHeaderBadge();
  window.addEventListener('aj-user-store-updated', updateHeaderBadge);
</script>
