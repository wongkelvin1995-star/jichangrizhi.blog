---
interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

// Helper to determine active state cleanly
const isPathActive = (path: string) => {
  if (path === '/') {
    return currentPath === '/' || currentPath === '';
  }
  if (path === '/airports/' || path === '/airports') {
    return currentPath.startsWith('/airports') || currentPath.startsWith('/archives');
  }
  if (path === '/brands/' || path === '/brands') {
    return currentPath.startsWith('/brands');
  }
  if (path === '/guides/' || path === '/guides') {
    return currentPath.startsWith('/guides');
  }
  if (path === '/risk-alerts/' || path === '/risk-alerts') {
    return currentPath.startsWith('/risk-alerts') || currentPath.startsWith('/airport-alerts');
  }
  if (path === '/about/' || path === '/about') {
    return currentPath.startsWith('/about');
  }
  if (path === '/search/' || path === '/search') {
    return currentPath.startsWith('/search');
  }
  if (path === '/personal-center/' || path === '/personal-center') {
    return currentPath.startsWith('/personal-center');
  }
  return currentPath.startsWith(path);
};
