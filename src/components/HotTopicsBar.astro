---
// Category Quick Bar / Hot Topics Bar
---

<div class="hot-topics-container">
  <div class="container">
    <div class="hot-topics-card">
      <div class="hot-topics-label">
        <span class="hot-indicator"></span>
        <span class="label-text">热门话题</span>
      </div>
      <div class="hot-topics-divider" aria-hidden="true"></div>
      <nav class="hot-topics-list" aria-label="主题快捷入口">
        <a href="#airports" class="topic-chip">
          <span class="topic-icon">✈</span>
          <span>机场品牌</span>
        </a>
        <a href="#plans-overview" class="topic-chip">
          <span class="topic-icon">📦</span>
          <span>套餐对比</span>
        </a>
        <a href="#nodes-overview" class="topic-chip">
          <span class="topic-icon">🌐</span>
          <span>节点地区</span>
        </a>
        <a href="#guide" class="topic-chip">
          <span class="topic-icon">📖</span>
          <span>使用指南</span>
        </a>
        <a href="#guide-selection" class="topic-chip">
          <span class="topic-icon">⚡</span>
          <span>选购建议</span>
        </a>
        <a href="/airport-alerts/" class="topic-chip alert-chip">
          <span class="topic-icon">⚠</span>
          <span>风险预警</span>
        </a>
      </nav>
    </div>
  </div>
</div>

<style>
  .hot-topics-container {
    padding: 8px 0 24px 0;
  }

  .hot-topics-card {
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: var(--radius-full);
    padding: 8px 18px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 4px 16px -2px rgba(19, 35, 68, 0.04);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  @media (max-width: 640px) {
    .hot-topics-card {
      border-radius: var(--radius-md);
      padding: 10px 14px;
    }
  }

  .hot-topics-label {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .hot-indicator {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
  }

  .label-text {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-title);
    white-space: nowrap;
  }

  .hot-topics-divider {
    width: 1px;
    height: 18px;
    background: var(--color-border);
    flex-shrink: 0;
  }

  .hot-topics-list {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: nowrap;
  }

  .topic-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--color-body);
    background: #F8FAFC;
    border: 1px solid var(--color-border-light);
    white-space: nowrap;
    text-decoration: none;
    transition: var(--transition-base);
  }

  .topic-chip:hover {
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-color: var(--color-primary-border);
  }

  .topic-chip.alert-chip {
    color: #DC2626;
    background: #FEF2F2;
    border-color: rgba(220, 38, 38, 0.2);
  }

  .topic-chip.alert-chip:hover {
    background: #FEE2E2;
  }

  .topic-icon {
    font-size: 0.9rem;
  }
</style>
