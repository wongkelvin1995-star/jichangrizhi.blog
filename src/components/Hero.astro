---
interface Props {
  brandCount: number;
}

const { brandCount = 17 } = Astro.props;
---

<section class="hero-section" id="hero">
  <!-- Aviation Photography & Ambient Aurora Overlay -->
  <div class="hero-bg-overlay" aria-hidden="true">
    <div class="hero-airport-photo"></div>
    <div class="hero-ambient-glow glow-1"></div>
    <div class="hero-ambient-glow glow-2"></div>
    <div class="hero-grid-pattern"></div>
  </div>

  <div class="container hero-container">
    <div class="hero-content">
      <div class="hero-badge-wrap">
        <span class="hero-version-pill">
          <span class="pill-dot"></span>
          Airport Journal MAX · 机场日志旗舰
        </span>
      </div>

      <h1 class="hero-title">
        2027 机场日志
        <span class="hero-subtitle-block">专注机场品牌、套餐、节点与使用指南的专业博客</span>
      </h1>

      <p class="hero-description">
        机场日志 / Airport Journal — 深度整理主流机场品牌档案、套餐信息、节点地区与实用使用指南，帮助你更高效地了解、选择与使用各类网络连接服务。
      </p>

      <div class="hero-cta-group">
        <a href="#airports" class="btn btn-primary btn-hero-lg">
          探索机场档案 ({brandCount}家品牌)
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="#guide" class="btn btn-secondary btn-hero-lg">
          查看使用指南
        </a>
      </div>

      <!-- Quick Inline Search Box -->
      <div class="hero-search-wrapper">
        <div class="hero-search-box">
          <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input
            type="search"
            id="heroBrandSearchInput"
            class="hero-search-input"
            placeholder="搜索机场、品牌、套餐、关键词..."
            aria-label="搜索机场品牌与套餐"
            autocomplete="off"
          />
          <button type="button" id="clearHeroSearch" class="search-clear-btn" aria-label="清空搜索" style="display: none;">
            ✕
          </button>
        </div>
        <div id="heroSearchResults" class="hero-search-dropdown" style="display: none;"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 68px 0 60px 0;
    overflow: hidden;
    background: linear-gradient(180deg, rgba(240, 246, 255, 0.72) 0%, rgba(247, 250, 255, 0.45) 100%);
    border-bottom: 1px solid var(--color-border);
  }

  .hero-airport-photo {
    position: absolute;
    top: 0;
    right: 0;
    width: 52%;
    height: 100%;
    background-image: url('/images/hero-airport.webp');
    background-repeat: no-repeat;
    background-position: right top;
    background-size: cover;
    opacity: 0.36;
    mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.4) 30%, rgba(0, 0, 0, 1) 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.4) 30%, rgba(0, 0, 0, 1) 100%);
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero-airport-photo {
      width: 100%;
      opacity: 0.18;
      mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.5) 40%, transparent 100%);
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, rgba(0, 0, 0, 0.5) 40%, transparent 100%);
    }
  }

  .hero-bg-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-ambient-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.6;
  }

  .glow-1 {
    top: -120px;
    right: 5%;
    width: 420px;
    height: 420px;
    background: radial-gradient(circle, rgba(40, 92, 240, 0.22) 0%, rgba(56, 189, 248, 0.05) 70%, transparent 100%);
  }

  .glow-2 {
    bottom: -100px;
    left: 8%;
    width: 360px;
    height: 360px;
    background: radial-gradient(circle, rgba(40, 92, 240, 0.12) 0%, rgba(240, 246, 255, 0.05) 70%, transparent 100%);
  }

  .hero-grid-pattern {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(#CBD5E1 1px, transparent 1px);
    background-size: 32px 32px;
    opacity: 0.35;
  }

  .hero-container {
    position: relative;
    z-index: 10;
  }

  .hero-content {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  .hero-badge-wrap {
    margin-bottom: 20px;
    display: inline-block;
  }

  .hero-version-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    background: #FFFFFF;
    border: 1px solid rgba(40, 92, 240, 0.25);
    border-radius: var(--radius-full);
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--color-primary);
    box-shadow: 0 2px 10px rgba(40, 92, 240, 0.08);
  }

  .pill-dot {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 0 3px rgba(40, 92, 240, 0.2);
  }

  .hero-title {
    font-size: 2.85rem;
    font-weight: 800;
    color: var(--color-title);
    letter-spacing: -0.03em;
    line-height: 1.2;
    margin-bottom: 20px;
  }

  .hero-subtitle-block {
    display: block;
    font-size: 1.6rem;
    font-weight: 700;
    color: #1E293B;
    margin-top: 10px;
    letter-spacing: -0.02em;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.1rem;
    }
    .hero-subtitle-block {
      font-size: 1.25rem;
    }
  }

  .hero-description {
    font-size: 1.1rem;
    color: var(--color-muted);
    line-height: 1.7;
    margin: 0 auto 32px auto;
    max-width: 720px;
  }

  .hero-cta-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .btn-hero-lg {
    padding: 13px 28px;
    font-size: 1.02rem;
  }

  /* Inline Search Box */
  .hero-search-wrapper {
    position: relative;
    max-width: 620px;
    margin: 0 auto;
  }

  .hero-search-box {
    display: flex;
    align-items: center;
    background: #FFFFFF;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: 6px 18px;
    box-shadow: 0 8px 24px -4px rgba(19, 35, 68, 0.08);
    transition: var(--transition-base);
  }

  .hero-search-box:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 10px 30px -4px rgba(40, 92, 240, 0.22);
  }

  .search-icon {
    color: var(--color-primary);
    margin-right: 12px;
    flex-shrink: 0;
  }

  .hero-search-input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 1rem;
    color: var(--color-title);
    background: transparent;
    padding: 8px 0;
  }

  .hero-search-input::placeholder {
    color: var(--color-light-muted);
    font-size: 0.94rem;
  }

  .search-clear-btn {
    background: #E2E8F0;
    border: none;
    color: #475569;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-search-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    right: 0;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    max-height: 340px;
    overflow-y: auto;
    z-index: 100;
    text-align: left;
    padding: 8px 0;
  }
</style>

<script>
  import { searchSite } from '../lib/search-engine.ts';

  const searchInput = document.getElementById('heroBrandSearchInput') as HTMLInputElement | null;
  const searchResults = document.getElementById('heroSearchResults');
  const clearBtn = document.getElementById('clearHeroSearch');

  let heroSearchIndex: any[] | null = null;
  let heroDebounce: any = null;

  async function getHeroIndex() {
    if (heroSearchIndex) return heroSearchIndex;
    try {
      const res = await fetch('/search-index.json');
      if (res.ok) {
        heroSearchIndex = await res.json();
        return heroSearchIndex;
      }
    } catch (e) {
      console.warn('Failed to fetch /search-index.json', e);
    }
    return (window as any).__SEARCH_INDEX__ || [];
  }

  if (searchInput && searchResults && clearBtn) {
    searchInput.addEventListener('input', () => {
      clearTimeout(heroDebounce);
      heroDebounce = setTimeout(async () => {
        const query = searchInput.value.trim();
        if (!query) {
          searchResults.style.display = 'none';
          clearBtn.style.display = 'none';
          return;
        }
        clearBtn.style.display = 'block';

        const index = await getHeroIndex();
        const grouped = searchSite(index, query);

        if (grouped.total === 0) {
          searchResults.innerHTML = `
            <div style="padding: 20px 16px; text-align: center; color: #65738C; font-size: 0.92rem;">
              暂未找到包含 “${query}” 的相关内容<br>
              <a href="/search/?q=${encodeURIComponent(query)}" style="color: #285CF0; font-weight: 700; display: inline-block; margin-top: 6px;">进入全站搜索页查看 →</a>
            </div>
          `;
        } else {
          let html = '';
          const topList = grouped.all.slice(0, 7);
          topList.forEach((r: any) => {
            const item = r.item;
            const badge = item.price || item.badge || item.typeName;
            html += `
              <a href="${item.url}" class="search-result-row" style="display: flex; align-items: center; justify-content: space-between; padding: 10px 18px; text-decoration: none; border-bottom: 1px solid #F1F5F9; color: inherit; transition: background 0.15s;">
                <div style="overflow: hidden; padding-right: 12px;">
                  <div style="font-weight: 700; color: #132344; font-size: 0.96rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    ${r.highlightedTitle}
                  </div>
                  <div style="color: #65738C; font-size: 0.8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    ${r.highlightedSubtitle || r.highlightedSnippet}
                  </div>
                </div>
                <span style="color: #285CF0; font-size: 0.78rem; font-weight: 600; background: #EFF4FF; padding: 2px 8px; border-radius: 4px; white-space: nowrap;">
                  ${badge}
                </span>
              </a>
            `;
          });

          html += `
            <div style="padding: 10px 18px; text-align: center; background: #F8FAFC; border-top: 1px solid #F1F5F9;">
              <a href="/search/?q=${encodeURIComponent(query)}" style="color: #285CF0; font-size: 0.88rem; font-weight: 700; text-decoration: none;">
                查看全部 ${grouped.total} 条结果 →
              </a>
            </div>
          `;

          searchResults.innerHTML = html;
        }
        searchResults.style.display = 'block';
      }, 150);
    });

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && searchInput.value.trim()) {
        window.location.href = `/search/?q=${encodeURIComponent(searchInput.value.trim())}`;
      }
    });

    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      searchResults.style.display = 'none';
      clearBtn.style.display = 'none';
      searchInput.focus();
    });

    // Close on outside click
    document.addEventListener('click', (e) => {
      if (!searchInput.contains(e.target as Node) && !searchResults.contains(e.target as Node)) {
        searchResults.style.display = 'none';
      }
    });
  }
</script>
