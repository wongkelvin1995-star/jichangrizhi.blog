---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllBrands } from '../../lib/brand-parser.ts';
import { BRAND_ORDER } from '../../lib/brand-config.ts';

const brands = getAllBrands();

// SEO Metadata strictly per instruction
const pageTitle = "2027机场档案大全｜机场套餐价格、节点地区、线路协议与品牌资料查询 - 机场日志";
const pageDescription = "机场日志提供机场品牌详细档案，整理各大机场套餐价格、流量规格、节点地区、线路协议、客户端兼容及订阅信息，帮助用户快速查询机场资料。";
const canonicalPath = "/airports/";

// Merge config with parsed brand data
const brandArchives = BRAND_ORDER.map(cfg => {
  const brand = brands.find(b => b.id === cfg.id);
  return {
    order: cfg.order,
    id: cfg.id,
    name: cfg.name,
    tagline: cfg.tagline,
    badge: cfg.badge,
    brand
  };
}).filter(item => item.brand !== undefined);

// Calculate price ranges for display
const getPriceRange = (plans: any[]) => {
  if (!plans || plans.length === 0) return { min: "详见官网", cycle: "" };
  const prices = plans.map(p => {
    const num = parseFloat(p.price.replace(/[^\d.]/g, ''));
    return isNaN(num) ? 999999 : num;
  });
  const minPrice = Math.min(...prices);
  if (minPrice === 999999) return { min: plans[0].price, cycle: plans[0].cycle };
  const minPlan = plans.find(p => p.price.includes(String(minPrice)) || parseFloat(p.price.replace(/[^\d.]/g, '')) === minPrice);
  return {
    min: `¥${minPrice}`,
    cycle: minPlan?.cycle ? `/${minPlan.cycle}` : '/月'
  };
};

const getTrafficRange = (plans: any[]) => {
  if (!plans || plans.length === 0) return "按需自选";
  const traffics = plans.map(p => p.traffic).filter(Boolean);
  if (traffics.length === 1) return traffics[0];
  return `${traffics[0]} ~ ${traffics[traffics.length - 1]}`;
};

// FAQ Data for Airports Archive Hub
const archiveFaqs = [
  {
    q: "2027 机场日志收录的机场档案资料从何而来？数据可信度如何保障？",
    a: "本站收录的全部 18 家机场品牌档案均来源于服务商公开发布的官方文档、前台套餐说明、控制台测速记录与用户服务协议。所有资料均标注了核验日期（2026-11-23 至 2026-11-24），由编辑团队逐项核实节点地区、网络协议、套餐价格与退款条款，不虚构测速数据或不存在的优惠承诺。"
  },
  {
    q: "如何通过线路类型（IPLC 专线 / IEPL 专线 / 隧道 BGP）快速筛选适合自己的机场？",
    a: "如果您的核心诉求是高稳定性、低延迟晚高峰不卡顿（如跨境商务、在线会议、对实时性要求极高），建议优先选择 IPLC/IEPL 纯内网专线机场（如灵动云、暮光加速、大佬云）；如果是日常浏览、流媒体追剧、查阅资料等大流量场景，优质 BGP 隧道中转机场（如微风网络、FLYV）能够提供极高性价比与充足的月度流量。"
  },
  {
    q: "为什么不同机场的套餐资费差异巨大？应该如何评估性价比？",
    a: "机场套餐价格取决于底层网络带宽成本（如专线带宽单价通常为公网中转的 3~5 倍）、服务器集群冗余、SLA 保证以及客服响应机制。建议用户结合自身月度实际消耗流量选择套餐，不必盲目追逐过大流量年付包，遵循「小额月付、按需续费」原则能够最大程度平衡体验与资金安全。"
  },
  {
    q: "档案中的各机场订阅链接支持哪些主流客户端？需要手动转换格式吗？",
    a: "目前收录的绝大多数品牌均提供自建一键客户端或标准的 Universal / Clash / Shadowrocket 订阅链接。主流客户端如 Clash Verge Rev、v2rayN、Surge、Shadowrocket (小火箭)、Sing-box 及 Quantumult X 均可直接解析导入，无需第三方转换工具，确保订阅安全防泄漏。"
  },
  {
    q: "机场品牌档案中的套餐价格与优惠信息多久更新一次？",
    a: "机场日志团队每月例行复核各品牌最新的定价策略、节点增删以及促销代码。当机场调整套餐规格或调整网络架构时，档案页面将同步修订并在资料末尾更新核验时间。若您发现任何信息变更，可通过本站关于页面的纠错入口向我们反馈。"
  }
];

// Rich JSON-LD Schemas
const archiveItemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: pageTitle,
  description: pageDescription,
  numberOfItems: brandArchives.length,
  itemListElement: brandArchives.map((item, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: `${item.name} 机场详细档案`,
    url: `https://jichangrizhi.blog/airports/${item.id}/`
  }))
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: 'https://jichangrizhi.blog/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '机场档案',
      item: 'https://jichangrizhi.blog/airports/'
    }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: archiveFaqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  jsonLdSchema={[breadcrumbSchema, archiveItemListSchema, faqSchema]}
>
  <div class="airports-archive-page">
    <!-- Breadcrumbs -->
    <nav class="page-breadcrumbs container" aria-label="面包屑导航">
      <ol class="breadcrumb-list">
        <li><a href="/">首页</a></li>
        <li class="separator">/</li>
        <li aria-current="page">机场档案</li>
      </ol>
    </nav>

    <!-- Header Banner -->
    <header class="page-header-banner">
      <div class="container">
        <div class="banner-badge-wrap">
          <span class="badge-tag blue">权威档案库</span>
          <span class="badge-tag success">已核验 {brandArchives.length} 家品牌资料</span>
        </div>
        <h1 class="page-main-h1">2027机场品牌档案与套餐资料数据库</h1>
        <p class="page-intro-desc">
          机场日志提供机场品牌详细档案，整理各大机场套餐价格、流量规格、节点地区、线路协议、客户端兼容及订阅信息，帮助用户快速查询机场资料。
        </p>

        <!-- Core Keyword Pills -->
        <div class="seo-keywords-strip">
          <span class="kw-label">收录维度：</span>
          <span class="kw-tag">机场档案</span>
          <span class="kw-tag">机场资料</span>
          <span class="kw-tag">机场套餐</span>
          <span class="kw-tag">机场价格</span>
          <span class="kw-tag">机场节点</span>
          <span class="kw-tag">机场线路</span>
          <span class="kw-tag">机场订阅</span>
          <span class="kw-tag">客户端兼容</span>
        </div>

        <!-- Filter & Search Box -->
        <div class="archive-controls-card">
          <div class="archive-search-bar">
            <svg class="search-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="archiveBrandSearch"
              class="archive-search-field"
              placeholder="快速搜索档案品牌、协议、地区（如：灵动云、大佬云、IPLC、Trojan、香港）..."
              aria-label="实时检索机场档案"
              autocomplete="off"
            />
          </div>

          <div class="archive-filter-tags" id="categoryFilterTags">
            <button type="button" class="filter-pill active" data-filter="all">全部品牌 ({brandArchives.length})</button>
            <button type="button" class="filter-pill" data-filter="iplc">IPLC/IEPL 专线</button>
            <button type="button" class="filter-pill" data-filter="bgp">BGP 隧道中转</button>
            <button type="button" class="filter-pill" data-filter="budget">高性价比实惠</button>
            <button type="button" class="filter-pill" data-filter="streaming">流媒体与AI解锁</button>
          </div>
        </div>
      </div>
    </header>

    <!-- Brand Archives Grid -->
    <main class="container archive-cards-container" id="archiveGridSection">
      <div class="archive-cards-grid" id="brandCardsGrid">
        {brandArchives.map(item => {
          const b = item.brand!;
          const priceInfo = getPriceRange(b.plans);
          const trafficInfo = getTrafficRange(b.plans);
          const isIplc = (b.lineTypes || '').toLowerCase().includes('iplc') || (b.lineTypes || '').toLowerCase().includes('iepl') || (item.badge || '').includes('专线');
          const isBgp = (b.lineTypes || '').toLowerCase().includes('bgp') || (b.lineTypes || '').includes('隧道');
          const isBudget = priceInfo.min.includes('¥1') || priceInfo.min.includes('¥2') || (item.tagline || '').includes('性价比');

          return (
            <article
              class="journal-card archive-brand-card"
              data-brand-id={item.id}
              data-brand-name={item.name.toLowerCase()}
              data-en-name={b.englishName.toLowerCase()}
              data-lines={(b.lineTypes || '').toLowerCase()}
              data-nodes={(b.nodeRegions || '').toLowerCase()}
              data-protocols={(b.protocols || '').toLowerCase()}
              data-category={`${isIplc ? 'iplc ' : ''}${isBgp ? 'bgp ' : ''}${isBudget ? 'budget ' : ''}streaming`}
            >
              <!-- Card Header -->
              <div class="archive-card-top">
                <div class="brand-rank-wrap">
                  <span class="brand-order-number">序位 {String(item.order).padStart(2, '0')}</span>
                  {item.badge && <span class="badge-tag blue">{item.badge}</span>}
                </div>
                <div class="card-top-right">
                  <button
                    type="button"
                    class="btn-fav-card-toggle"
                    data-brand-id={item.id}
                    data-name={item.name}
                    data-english-name={b.englishName}
                    data-tagline={item.tagline || b.positioning}
                    data-min-price={priceInfo.min}
                    data-node-regions={b.nodeRegions || '主流地区'}
                    data-line-types={b.lineTypes || '多线中转'}
                    data-protocols={b.protocols || '通用协议'}
                    data-url={`/airports/${item.id}/`}
                    title="收藏此机场"
                    aria-label={`收藏 ${item.name}`}
                  >
                    <svg class="heart-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  </button>
                  <span class="verify-date-badge">核验于 {b.source?.verifyDate || '2026-11-24'}</span>
                </div>
              </div>

              <!-- Brand Name & Positioning -->
              <div class="archive-card-title-group">
                <h2 class="archive-card-h2">
                  <a href={`/airports/${item.id}/`} class="archive-title-link">
                    {item.name}
                  </a>
                  <span class="archive-en-name">({b.englishName})</span>
                </h2>
                <p class="archive-brand-tagline">{item.tagline || b.positioning}</p>
              </div>

              <!-- Tech Specs Grid -->
              <div class="archive-specs-box">
                <div class="spec-row">
                  <span class="spec-label">线路架构：</span>
                  <span class="spec-value highlight">{b.lineTypes || '多线 BGP / 专线中转'}</span>
                </div>
                <div class="spec-row">
                  <span class="spec-label">节点覆盖：</span>
                  <span class="spec-value" title={b.nodeRegions}>{b.nodeRegions || '港/台/日/新/美等主流地区'}</span>
                </div>
                <div class="spec-row">
                  <span class="spec-label">支持协议：</span>
                  <span class="spec-value code-font">{b.protocols || 'Shadowsocks / Trojan / Vless'}</span>
                </div>
                <div class="spec-row">
                  <span class="spec-label">客户端支持：</span>
                  <span class="spec-value">Clash / Surge / 小火箭 / v2rayN / Sing-box</span>
                </div>
              </div>

              <!-- Price & Quota Banner -->
              <div class="archive-pricing-summary">
                <div class="pricing-col">
                  <span class="price-title">套餐价格门槛</span>
                  <div class="price-figure">
                    <span class="price-val">{priceInfo.min}</span>
                    <span class="price-cycle">{priceInfo.cycle}起</span>
                  </div>
                </div>
                <div class="traffic-col">
                  <span class="traffic-title">流量规格</span>
                  <span class="traffic-val">{trafficInfo}</span>
                </div>
                <div class="plans-count-col">
                  <span class="plans-count-tag">{b.plans?.length || 0} 个规格在售</span>
                </div>
              </div>

              <!-- Card Action Buttons -->
              <div class="archive-card-actions">
                <a href={`/airports/${item.id}/`} class="btn-archive-primary">
                  <span>查看品牌完整档案</span>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <a
                  href={b.registerUrl || b.links?.purchase || b.website}
                  target="_blank"
                  rel="nofollow noopener noreferrer"
                  class="btn-archive-aff"
                >
                  <span>直达官网套餐</span>
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <!-- No Results Fallback -->
      <div id="noArchiveResults" class="no-results-banner" style="display: none;">
        <p class="no-results-text">未找到符合条件的机场档案，请尝试更换关键词（如“专线”、“Clash”、“香港”）。</p>
      </div>
    </main>

    <!-- Dedicated Airports Archive FAQ -->
    <section class="container archive-faq-section">
      <div class="section-heading-bar">
        <div class="section-heading-left">
          <span class="heading-accent-bar"></span>
          <h2 class="section-main-title">机场品牌档案与选购常见问题解答 (FAQ)</h2>
          <span class="section-sub-desc">基于客观测评经验与公开技术资料整理，助您快速掌握辨别技巧</span>
        </div>
      </div>

      <div class="archive-faq-grid">
        {archiveFaqs.map((faq, index) => (
          <div class="journal-card archive-faq-card">
            <h3 class="faq-question">
              <span class="faq-q-mark">Q{index + 1}.</span>
              {faq.q}
            </h3>
            <p class="faq-answer">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Client-side instant filtering and search
  const searchInput = document.getElementById('archiveBrandSearch') as HTMLInputElement | null;
  const cards = document.querySelectorAll('.archive-brand-card') as NodeListOf<HTMLElement>;
  const filterPills = document.querySelectorAll('#categoryFilterTags .filter-pill') as NodeListOf<HTMLButtonElement>;
  const noResults = document.getElementById('noArchiveResults');

  let activeCategory = 'all';
  let searchQuery = '';

  const applyFilters = () => {
    let matchCount = 0;
    cards.forEach(card => {
      const brandName = card.dataset.brandName || '';
      const enName = card.dataset.enName || '';
      const lines = card.dataset.lines || '';
      const nodes = card.dataset.nodes || '';
      const protocols = card.dataset.protocols || '';
      const category = card.dataset.category || '';

      const matchesSearch = !searchQuery ||
        brandName.includes(searchQuery) ||
        enName.includes(searchQuery) ||
        lines.includes(searchQuery) ||
        nodes.includes(searchQuery) ||
        protocols.includes(searchQuery);

      const matchesCategory = activeCategory === 'all' || category.includes(activeCategory);

      if (matchesSearch && matchesCategory) {
        card.style.display = 'flex';
        matchCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = matchCount === 0 ? 'block' : 'none';
    }
  };

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchQuery = searchInput.value.trim().toLowerCase();
      applyFilters();
    });
  }

  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeCategory = pill.dataset.filter || 'all';
      applyFilters();
    });
  });

  // UserStore integration: Favorites and History
  import { UserStore } from '../../lib/user-store.ts';

  UserStore.recordHistory({
    url: '/airports/',
    title: '2027机场品牌档案与套餐资料数据库',
    type: 'page',
    typeName: '机场档案'
  });

  const favButtons = document.querySelectorAll('.btn-fav-card-toggle') as NodeListOf<HTMLButtonElement>;

  function syncFavButtonsState() {
    favButtons.forEach(btn => {
      const bId = btn.dataset.brandId;
      if (!bId) return;
      const isFav = UserStore.isBrandFavorited(bId);
      if (isFav) {
        btn.classList.add('favorited');
        btn.setAttribute('title', '已收藏，点击取消收藏');
      } else {
        btn.classList.remove('favorited');
        btn.setAttribute('title', '收藏此机场品牌');
      }
    });
  }

  favButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      const bId = btn.dataset.brandId!;
      UserStore.toggleFavoriteBrand({
        brandId: bId,
        name: btn.dataset.name!,
        englishName: btn.dataset.englishName!,
        tagline: btn.dataset.tagline!,
        minPrice: btn.dataset.minPrice!,
        nodeRegions: btn.dataset.nodeRegions!,
        lineTypes: btn.dataset.lineTypes!,
        protocols: btn.dataset.protocols!,
        url: btn.dataset.url!
      });
      syncFavButtonsState();
    });
  });

  syncFavButtonsState();
  window.addEventListener('aj-user-store-updated', syncFavButtonsState);
</script>

<style>
  .airports-archive-page {
    padding-bottom: 72px;
  }

  /* Breadcrumbs */
  .page-breadcrumbs {
    padding-top: 20px;
    padding-bottom: 12px;
  }
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-secondary);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .breadcrumb-list a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .breadcrumb-list a:hover {
    color: var(--color-primary);
  }
  .breadcrumb-list .separator {
    color: #BDC5D0;
  }

  /* Header Banner */
  .page-header-banner {
    padding: 32px 0 28px 0;
    background: linear-gradient(180deg, rgba(235, 243, 255, 0.4) 0%, rgba(255, 255, 255, 0) 100%);
    border-bottom: 1px solid rgba(226, 232, 240, 0.6);
  }
  .banner-badge-wrap {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }
  .page-main-h1 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 14px;
    line-height: 1.25;
  }
  .page-intro-desc {
    font-size: 16px;
    color: var(--color-text-secondary);
    max-width: 860px;
    line-height: 1.65;
    margin-bottom: 18px;
  }

  .seo-keywords-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    font-size: 13px;
  }
  .kw-label {
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .kw-tag {
    background: #F1F5F9;
    color: #475569;
    padding: 2px 9px;
    border-radius: 6px;
    font-weight: 500;
  }

  /* Filter & Search Bar */
  .archive-controls-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
