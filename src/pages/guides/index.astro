---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDE_ARTICLES } from '../../lib/guides-data.ts';

const pageTitle = "2027机场使用指南｜Clash教程、订阅导入、客户端下载与节点配置 - 机场日志";
const pageH1 = "机场使用指南与客户端教程大全";
const pageDescription = "机场日志提供2027全平台机场使用教程，涵盖Clash客户端配置、Windows/macOS/iOS/Android各系统客户端下载使用、订阅链接导入与更新、节点测速选择及常见连接故障排除指南。";
const canonicalPath = "/guides/";

const categories = ['全部', '新手入门', '客户端配置', '系统平台', '订阅技巧', '选购技巧', '故障排查'];

// General FAQs for Guides Hub
const hubFaqs = [
  {
    q: "刚购买了机场订阅，第一步应该做什么？",
    a: "首先根据您使用的设备系统（Windows、macOS、安卓手机或 iPhone），在指南目录中选择对应的「平台使用教程」；下载推荐的官方开源客户端（如 Clash Verge Rev、v2rayN 或 Shadowrocket）；随后在机场官网后台复制订阅链接粘贴导入，开启规则分流即可畅享高速网络。"
  },
  {
    q: "为什么建议所有设备优先使用「规则分流 (Rule)」模式？",
    a: "规则分流通过内置的 GEOIP 与域名规则列表，自动识别国内和海外网站。当您访问百度、微信、网银时直接走本地直连，不消耗机场流量且网速无任何损耗；仅在访问海外受限网站时才通过代理服务器，省心且智能。"
  },
  {
    q: "电脑端和手机端客户端的节点数据能自动同步吗？",
    a: "不同设备上的客户端是相互独立的，但它们都可以通过相同的「订阅链接」从机场服务器拉取最新的节点配置。只要分别在各设备导入订阅并开启自动更新，节点列表和网络状态就会保持同步。"
  },
  {
    q: "遇到网络连不上时，最先排查哪三个环节？",
    a: "第一核对设备系统时间是否精准到秒（误差超90秒会导致TLS握手失败）；第二确认套餐流量是否耗尽或账号已过期；第三测试切换其他备用节点并重置系统代理开关。"
  }
];

// Rich Schemas
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: 'https://jichangrizhi.blog/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '使用指南',
      item: 'https://jichangrizhi.blog/guides/'
    }
  ]
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: pageTitle,
  description: pageDescription,
  numberOfItems: GUIDE_ARTICLES.length,
  itemListElement: GUIDE_ARTICLES.map((article, idx) => ({
    '@type': 'ListItem',
    position: idx + 1,
    name: article.title,
    url: `https://jichangrizhi.blog/guides/${article.slug}/`
  }))
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: hubFaqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  jsonLdSchema={[breadcrumbSchema, itemListSchema, faqSchema]}
>
  <div class="guides-hub-page">
    <!-- Breadcrumbs -->
    <nav class="page-breadcrumbs container" aria-label="面包屑导航">
      <ol class="breadcrumb-list">
        <li><a href="/">首页</a></li>
        <li class="separator">/</li>
        <li aria-current="page">使用指南</li>
      </ol>
    </nav>

    <!-- Header Banner -->
    <header class="page-header-banner">
      <div class="container">
        <div class="banner-badge-wrap">
          <span class="badge-tag blue">教程知识库</span>
          <span class="badge-tag success">收录 {GUIDE_ARTICLES.length} 篇实战全解析</span>
        </div>
        <h1 class="page-main-h1">{pageH1}</h1>
        <p class="page-intro-desc">
          系统整理 2027 全平台机场客户端配置与实战技巧，涵盖从零基础概念、主流客户端（Clash / Surge / 小火箭 / v2rayN）设置到订阅安全、节点测速与疑难故障排查，帮您快速建立顺畅的连接体验。
        </p>

        <!-- Core Keyword Strip -->
        <div class="seo-keywords-strip">
          <span class="kw-label">教程分类：</span>
          <span class="kw-tag">机场使用教程</span>
          <span class="kw-tag">Clash教程</span>
          <span class="kw-tag">Clash订阅导入</span>
          <span class="kw-tag">机场节点配置</span>
          <span class="kw-tag">机场客户端下载</span>
          <span class="kw-tag">机场订阅更新</span>
          <span class="kw-tag">机场连接失败</span>
        </div>

        <!-- Search & Category Filters -->
        <div class="guides-controls-card">
          <div class="guides-search-bar">
            <svg class="search-input-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="guideSearchInput"
              class="guide-search-field"
              placeholder="搜索教程标题、关键词（如：Clash、Mac、iOS、连不上、订阅、测速）..."
              aria-label="实时检索教程指南"
              autocomplete="off"
            />
          </div>

          <div class="guides-filter-tags" id="guideFilterTags">
            {categories.map((cat, idx) => (
              <button
                type="button"
                class={`filter-pill ${idx === 0 ? 'active' : ''}`}
                data-category={cat}
              >
                {cat}
              </button>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- Main Guides Grid -->
    <main class="container guides-cards-container">
      <div class="guides-cards-grid" id="guidesGrid">
        {GUIDE_ARTICLES.map((guide, idx) => (
          <article
            class="journal-card guide-article-card"
            data-title={guide.title.toLowerCase()}
            data-desc={guide.description.toLowerCase()}
            data-tags={guide.tags.join(' ').toLowerCase()}
            data-cat={guide.category}
          >
            <!-- Top Meta -->
            <div class="guide-card-top">
              <span class="guide-cat-badge">{guide.category}</span>
              <div class="guide-meta-sub">
                <span class="read-time-pill">阅读约 {guide.readTime}</span>
                <button
                  type="button"
                  class="btn-bookmark-card-toggle"
                  data-slug={guide.slug}
                  data-title={guide.title}
                  data-category={guide.category}
                  data-description={guide.description}
                  data-read-time={guide.readTime}
                  data-url={`/guides/${guide.slug}/`}
                  title="收藏此指南"
                  aria-label="收藏指南"
                >
                  <svg class="bookmark-svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                  </svg>
                </button>
              </div>
            </div>

            <!-- Title & Summary -->
            <div class="guide-card-body">
              <h2 class="guide-card-h2">
                <a href={`/guides/${guide.slug}/`} class="guide-title-link">
                  {guide.title}
                </a>
              </h2>
              <p class="guide-summary-text">{guide.description}</p>
            </div>

            <!-- Tags Strip -->
            <div class="guide-tags-row">
              {guide.tags.map(tag => (
                <span class="guide-tag-item">#{tag}</span>
              ))}
            </div>

            <!-- Action Link -->
            <div class="guide-card-action">
              <a href={`/guides/${guide.slug}/`} class="btn-read-guide">
                <span>阅读完整图文教程</span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- No Results Banner -->
      <div id="noGuideResults" class="no-results-banner" style="display: none;">
        <p class="no-results-text">未找到相关教程文章，请尝试更换搜索词或选择全部类别。</p>
      </div>
    </main>

    <!-- Dedicated Guides Hub FAQ -->
    <section class="container hub-faq-section">
      <div class="section-heading-bar">
        <div class="section-heading-left">
          <span class="heading-accent-bar"></span>
          <h2 class="section-main-title">机场配置与日常使用高频常见问题 (FAQ)</h2>
          <span class="section-sub-desc">汇总新手起步与多设备搭配时最容易产生疑惑的关键要点</span>
        </div>
      </div>

      <div class="hub-faq-grid">
        {hubFaqs.map((faq, index) => (
          <div class="journal-card hub-faq-card">
            <h3 class="faq-question">
              <span class="faq-q-mark">Q{index + 1}.</span>
              {faq.q}
            </h3>
            <p class="faq-answer">{faq.a}</p>
          </div>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  import { UserStore } from '../../lib/user-store.ts';

  // 1. Record History
  UserStore.recordHistory({
    url: window.location.pathname,
    title: document.querySelector('.page-main-h1')?.textContent?.trim() || document.title,
    type: 'guide',
    typeName: '指南大全'
  });

  // 2. Filter & Search
  const searchInput = document.getElementById('guideSearchInput') as HTMLInputElement | null;
  const cards = document.querySelectorAll('.guide-article-card') as NodeListOf<HTMLElement>;
  const filterPills = document.querySelectorAll('#guideFilterTags .filter-pill') as NodeListOf<HTMLButtonElement>;
  const noResults = document.getElementById('noGuideResults');

  let activeCat = '全部';
  let searchTerm = '';

  const applyFilters = () => {
    let matched = 0;
    cards.forEach(card => {
      const title = card.dataset.title || '';
      const desc = card.dataset.desc || '';
      const tags = card.dataset.tags || '';
      const cat = card.dataset.cat || '';

      const matchesSearch = !searchTerm || title.includes(searchTerm) || desc.includes(searchTerm) || tags.includes(searchTerm);
      const matchesCategory = activeCat === '全部' || cat === activeCat;

      if (matchesSearch && matchesCategory) {
        card.style.display = 'flex';
        matched++;
      } else {
        card.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = matched === 0 ? 'block' : 'none';
    }
  };

  if (searchInput) {
    searchInput.addEventListener('input', () => {
      searchTerm = searchInput.value.trim().toLowerCase();
      applyFilters();
    });
  }

  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeCat = pill.dataset.category || '全部';
      applyFilters();
    });
  });

  // 3. Bookmark Toggle
  const bookmarkCardBtns = document.querySelectorAll('.btn-bookmark-card-toggle') as NodeListOf<HTMLButtonElement>;

  function syncBookmarkCards() {
    bookmarkCardBtns.forEach(btn => {
      const slug = btn.dataset.slug!;
      const isBookmarked = UserStore.isArticleBookmarked(slug);
      if (isBookmarked) {
        btn.classList.add('bookmarked');
        btn.setAttribute('title', '已收藏');
      } else {
        btn.classList.remove('bookmarked');
        btn.setAttribute('title', '收藏指南');
      }
    });
  }

  bookmarkCardBtns.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      UserStore.toggleBookmarkArticle({
        slug: btn.dataset.slug!,
        title: btn.dataset.title!,
        category: btn.dataset.category!,
        description: btn.dataset.description!,
        url: btn.dataset.url!,
        readTime: btn.dataset.readTime!
      });
      syncBookmarkCards();
    });
  });

  syncBookmarkCards();
  window.addEventListener('aj-user-store-updated', () => {
    syncBookmarkCards();
  });
</script>

<style>
  .guides-hub-page {
    padding-bottom: 72px;
  }

  /* Breadcrumbs */
  .page-breadcrumbs {
    padding-top: 20px;
    padding-bottom: 12px;
  }
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-secondary);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .breadcrumb-list a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .breadcrumb-list a:hover {
    color: var(--color-primary);
  }
  .breadcrumb-list .separator {
    color: #BDC5D0;
  }

  /* Header Banner */
  .page-header-banner {
    padding: 32px 0 28px 0;
    background: linear-gradient(180deg, rgba(235, 243, 255, 0.4) 0%, rgba(255, 255, 255, 0) 100%);
    border-bottom: 1px solid rgba(226, 232, 240, 0.6);
  }
  .banner-badge-wrap {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
  }
  .page-main-h1 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 14px;
    line-height: 1.25;
  }
  .page-intro-desc {
    font-size: 16px;
    color: var(--color-text-secondary);
    max-width: 860px;
    line-height: 1.65;
    margin-bottom: 18px;
  }

  .seo-keywords-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    font-size: 13px;
  }
  .kw-label {
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .kw-tag {
    background: #F1F5F9;
    color: #475569;
    padding: 2px 9px;
    border-radius: 6px;
    font-weight: 500;
  }

  .guides-controls-card {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 18px 20px;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .guides-search-bar {
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-input-icon {
    position: absolute;
    left: 14px;
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .guide-search-field {
    width: 100%;
    height: 44px;
    padding-left: 44px;
    padding-right: 16px;
    background: #F8FAFC;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-btn);
    font-size: 14px;
    color: var(--color-text-primary);
    transition: all 0.2s ease;
  }
  .guide-search-field:focus {
    outline: none;
    background: #FFFFFF;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(40, 92, 240, 0.12);
  }

  .guides-filter-tags {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .filter-pill {
    padding: 6px 14px;
    background: #F1F5F9;
    border: 1px solid transparent;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    color: #475569;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .filter-pill:hover {
    background: #E2E8F0;
    color: var(--color-text-primary);
  }
  .filter-pill.active {
    background: var(--color-primary);
    color: #FFFFFF;
    border-color: var(--color-primary);
    box-shadow: 0 2px 8px rgba(40, 92, 240, 0.25);
  }

  /* Cards Grid */
  .guides-cards-container {
    padding-top: 32px;
  }
  .guides-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 24px;
  }

  .guide-article-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .guide-article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: #CBD5E1;
  }

  .guide-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
  }
  .guide-cat-badge {
    font-size: 11.5px;
    font-weight: 700;
    color: var(--color-primary);
    background: #EBF3FF;
    padding: 3px 9px;
    border-radius: 6px;
  }
  .guide-meta-sub {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .btn-bookmark-card-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    border-radius: 50%;
    color: #64748B;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-bookmark-card-toggle:hover {
    background: #EFF6FF;
    border-color: #93C5FD;
    color: #2454ED;
  }
  .btn-bookmark-card-toggle.bookmarked {
    background: #EFF6FF;
    border-color: #93C5FD;
    color: #2454ED;
  }
  .btn-bookmark-card-toggle.bookmarked .bookmark-svg {
    fill: #2454ED;
    stroke: #2454ED;
  }

  .guide-card-body {
    margin-bottom: 16px;
    flex-grow: 1;
  }
  .guide-card-h2 {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 10px 0;
    line-height: 1.4;
  }
  .guide-title-link {
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .guide-title-link:hover {
    color: var(--color-primary);
  }
  .guide-summary-text {
    font-size: 13.5px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  .guide-tags-row {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }
  .guide-tag-item {
    font-size: 11.5px;
    color: #64748B;
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
    padding: 2px 7px;
    border-radius: 4px;
  }

  .guide-card-action {
    margin-top: auto;
  }
  .btn-read-guide {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: #F8FAFC;
    color: var(--color-primary);
    font-size: 13.5px;
    font-weight: 600;
    border-radius: var(--radius-btn);
    border: 1px solid #E2E8F0;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .btn-read-guide:hover {
    background: var(--color-primary);
    color: #FFFFFF;
    border-color: var(--color-primary);
  }

  .no-results-banner {
    padding: 60px 20px;
    text-align: center;
    background: #FFFFFF;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-card);
    margin-top: 24px;
  }
  .no-results-text {
    font-size: 15px;
    color: var(--color-text-secondary);
  }

  /* FAQ Section */
  .hub-faq-section {
    padding-top: 56px;
  }
  .hub-faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(460px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .hub-faq-card {
    padding: 24px;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }
  .faq-question {
    font-size: 16px;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 10px 0;
    display: flex;
    align-items: baseline;
    gap: 8px;
    line-height: 1.45;
  }
  .faq-q-mark {
    color: var(--color-primary);
    font-weight: 800;
    font-size: 15px;
  }
  .faq-answer {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 768px) {
    .page-main-h1 {
      font-size: 24px;
    }
    .guides-cards-grid {
      grid-template-columns: 1fr;
    }
    .hub-faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
