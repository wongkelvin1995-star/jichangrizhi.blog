---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { GUIDE_ARTICLES, type GuideArticle } from '../../lib/guides-data.ts';
import { getAllBrands } from '../../lib/brand-parser.ts';

export async function getStaticPaths() {
  const mapping: { slug: string; guideSlug: string; customTitle?: string; customSeoTitle?: string; customH1?: string; customDesc?: string }[] = [
    {
      slug: 'airport-brand-guide',
      guideSlug: 'airport-brand-guide',
      customTitle: '主流机场品牌盘点：特色、定位与适用人群',
      customSeoTitle: '主流机场品牌盘点：特色、定位与适用人群深度解析 - 机场日志',
      customH1: '主流机场品牌盘点：特色、定位与适用人群深度解析',
      customDesc: '全面盘点梳理当前主流机场的品牌特点、线路风格与适用场景，详细对比灵动云、暮光加速、微风网络、大佬云等服务商，帮助你快速找到合适的服务。'
    },
    {
      slug: 'airport-plan-guide',
      guideSlug: 'plan-selection',
      customTitle: '机场套餐如何选择？价格、流量与性价比全解析',
      customSeoTitle: '机场套餐如何选择？价格、流量与性价比全解析 - 机场日志',
      customH1: '机场套餐如何选择？价格、流量与性价比全解析',
      customDesc: '从套餐结构、流量策略、价格区间到适用场景，全面解析如何选择高性价比的机场套餐，对比月付、年付与按量付费，传授防跑路与避坑秘诀。'
    },
    {
      slug: 'airport-node-regions',
      guideSlug: 'node-selection',
      customTitle: '机场节点地区详解：常见地区、延迟表现与使用建议',
      customSeoTitle: '机场节点地区详解：常见地区、延迟表现与使用建议 - 机场日志',
      customH1: '机场节点地区详解：常见地区、延迟表现与使用建议',
      customDesc: '系统介绍常见的节点地区分布、网络特点与使用建议，深入分析香港低延迟、日本稳定性、新加坡多流媒体及美国大带宽的延迟表现与测速技巧。'
    }
  ];

  return mapping.map(m => {
    const article = GUIDE_ARTICLES.find(g => g.slug === m.guideSlug) || GUIDE_ARTICLES[0];
    return {
      params: { slug: m.slug },
      props: {
        article,
        targetSlug: m.slug,
        customTitle: m.customTitle || article.title,
        customSeoTitle: m.customSeoTitle || article.seoTitle,
        customH1: m.customH1 || article.h1,
        customDesc: m.customDesc || article.description
      }
    };
  });
}

interface Props {
  article: GuideArticle;
  targetSlug: string;
  customTitle: string;
  customSeoTitle: string;
  customH1: string;
  customDesc: string;
}

const { article, targetSlug, customTitle, customSeoTitle, customH1, customDesc } = Astro.props;
const allBrands = getAllBrands();

// Match related brands data
const relatedBrands = article.relatedBrandIds.map(id => {
  return allBrands.find(b => b.id === id);
}).filter(Boolean);

// Other guides for recommendations
const otherGuides = GUIDE_ARTICLES.filter(g => g.slug !== article.slug).slice(0, 3);

const canonicalPath = `/articles/${targetSlug}/`;

// Schemas
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: 'https://jichangrizhi.blog/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '精选专栏',
      item: 'https://jichangrizhi.blog/articles/'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: customTitle,
      item: `https://jichangrizhi.blog/articles/${targetSlug}/`
    }
  ]
};

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: customH1,
  description: customDesc,
  datePublished: `${article.updateDate}T08:00:00+08:00`,
  dateModified: `${article.updateDate}T08:00:00+08:00`,
  author: {
    '@type': 'Organization',
    name: '2027 机场日志技术编辑部',
    url: 'https://jichangrizhi.blog/about/'
  },
  publisher: {
    '@type': 'Organization',
    name: '2027 机场日志',
    url: 'https://jichangrizhi.blog/'
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: article.faqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<BaseLayout
  title={customSeoTitle}
  description={customDesc}
  canonicalPath={canonicalPath}
  jsonLdSchema={[breadcrumbSchema, articleSchema, faqSchema]}
>
  <div class="guide-detail-page">
    <!-- Breadcrumbs -->
    <nav class="page-breadcrumbs container" aria-label="面包屑导航">
      <ol class="breadcrumb-list">
        <li><a href="/">首页</a></li>
        <li class="separator">/</li>
        <li><a href="/guides/">使用指南</a></li>
        <li class="separator">/</li>
        <li aria-current="page">{customTitle}</li>
      </ol>
    </nav>

    <!-- Guide Header Banner -->
    <header class="guide-header-banner">
      <div class="container">
        <div class="guide-meta-strip">
          <span class="badge-tag blue">{article.category}</span>
          <span class="guide-read-time">阅读时间：约 {article.readTime}</span>
          <span class="guide-date">最后更新：{article.updateDate}</span>
          <button
            type="button"
            id="guideBookmarkBtn"
            class="btn-bookmark-action"
            data-slug={targetSlug}
            data-title={customTitle}
            data-category={article.category}
            data-description={customDesc}
            data-read-time={article.readTime}
            data-url={`/articles/${targetSlug}/`}
            title="收藏此深度文章"
          >
            <svg class="bookmark-svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
            <span id="bookmarkBtnLabel">收藏文章</span>
          </button>
        </div>

        <h1 class="guide-main-h1">{customH1}</h1>

        <div class="guide-summary-callout">
          <div class="summary-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
          </div>
          <p class="summary-text">{article.summary}</p>
        </div>

        <div class="guide-tags-bar">
          <span class="tags-label">核心主题：</span>
          {article.tags.map(tag => (
            <span class="guide-kw-tag">#{tag}</span>
          ))}
        </div>
      </div>
    </header>

    <!-- Main Content Grid -->
    <main class="guide-body-layout container">
      <!-- Article Content Column -->
      <article class="guide-article-content">
        <!-- Quick TOC -->
        <nav class="guide-quick-toc journal-card" aria-label="本篇目录索引">
          <h2 class="toc-title">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <line x1="8" y1="6" x2="21" y2="6"></line>
              <line x1="8" y1="12" x2="21" y2="12"></line>
              <line x1="8" y1="18" x2="21" y2="18"></line>
              <line x1="3" y1="6" x2="3.01" y2="6"></line>
              <line x1="3" y1="12" x2="3.01" y2="12"></line>
              <line x1="3" y1="18" x2="3.01" y2="18"></line>
            </svg>
            章节导航
          </h2>
          <ol class="toc-list">
            {article.sections.map((sec, idx) => (
              <li>
                <a href={`#section-${idx + 1}`}>{sec.title}</a>
              </li>
            ))}
            {article.faqs && article.faqs.length > 0 && (
              <li>
                <a href="#section-faqs">常见疑问解答 (FAQ)</a>
              </li>
            )}
          </ol>
        </nav>

        <!-- Detailed Sections -->
        <div class="sections-container">
          {article.sections.map((sec, idx) => (
            <section class="guide-content-section" id={`section-${idx + 1}`}>
              <h2 class="section-heading">{sec.title}</h2>
              <div class="section-prose" set:html={sec.content}></div>
            </section>
          ))}
        </div>

        <!-- Exclusive FAQs -->
        {article.faqs && article.faqs.length > 0 && (
          <section class="guide-content-section faqs-section" id="section-faqs">
            <h2 class="section-heading">本篇常见问题答疑 (FAQ)</h2>
            <div class="faqs-accordion">
              {article.faqs.map(faq => (
                <details class="guide-faq-item">
                  <summary class="faq-question">
                    <span class="faq-q-badge">Q</span>
                    <span class="faq-q-text">{faq.q}</span>
                    <span class="faq-chevron">↓</span>
                  </summary>
                  <div class="faq-answer">
                    <p set:html={faq.a}></p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        )}

        <!-- Bottom Return & Nav -->
        <div class="guide-article-bottom-actions">
          <a href="/#featured" class="btn-return-hub">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
            返回首页精选导航
          </a>
          <a href="/airports/" class="btn-goto-airports">
            查看 2027 机场档案库 →
          </a>
        </div>
      </article>

      <!-- Sidebar -->
      <aside class="guide-sidebar">
        <!-- Related Brands Widget -->
        {relatedBrands.length > 0 && (
          <div class="sidebar-widget journal-card">
            <div class="widget-header">
              <span class="accent-bar"></span>
              <h3 class="widget-title">本篇提及机场档案</h3>
            </div>
            <div class="related-brands-list">
              {relatedBrands.map(brand => (
                <a href={`/airports/${brand.id}/`} class="related-brand-item">
                  <div class="rb-logo">
                    {brand.logo ? (
                      <img src={brand.logo} alt={brand.brandName} loading="lazy" />
                    ) : (
                      <span class="rb-logo-char">{brand.brandName.charAt(0)}</span>
                    )}
                  </div>
                  <div class="rb-info">
                    <span class="rb-name">{brand.brandName}</span>
                    <span class="rb-positioning">{brand.positioning || '精选高速机场'}</span>
                  </div>
                  <span class="rb-arrow">→</span>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Other Guides Widget -->
        <div class="sidebar-widget journal-card">
          <div class="widget-header">
            <span class="accent-bar"></span>
            <h3 class="widget-title">更多使用指南</h3>
          </div>
          <div class="other-guides-list">
            {otherGuides.map(g => (
              <a href={`/guides/${g.slug}/`} class="other-guide-item">
                <span class="og-badge">{g.category}</span>
                <span class="og-title">{g.title}</span>
                <span class="og-time">约 {g.readTime}</span>
              </a>
            ))}
          </div>
          <a href="/guides/" class="sidebar-more-link">进入完整指南知识库 →</a>
        </div>

        <!-- Risk Warning Banner Widget -->
        <div class="sidebar-widget journal-card risk-widget">
          <div class="widget-header">
            <span class="accent-bar red"></span>
            <h3 class="widget-title">安全避坑小提示</h3>
          </div>
          <p class="risk-widget-desc">
            机场网络属于动态中继服务。无论选择哪家服务商，请务必坚持<strong>「小额月付」</strong>，避免大额年付陷阱。
          </p>
          <a href="/risk-alerts/" class="btn-risk-link">查阅风险观察名单 →</a>
        </div>
      </aside>
    </main>
  </div>
</BaseLayout>

<script>
  import { UserStore } from '../../lib/user-store.ts';

  function initBookmarkBtn() {
    const btn = document.getElementById('guideBookmarkBtn');
    const label = document.getElementById('bookmarkBtnLabel');
    if (!btn || !label) return;

    const slug = btn.getAttribute('data-slug') || '';
    const title = btn.getAttribute('data-title') || '';
    const category = btn.getAttribute('data-category') || '';
    const description = btn.getAttribute('data-description') || '';
    const readTime = btn.getAttribute('data-read-time') || '';
    const url = btn.getAttribute('data-url') || window.location.pathname;

    function renderStatus() {
      const active = UserStore.isArticleBookmarked(slug);
      if (active) {
        btn.classList.add('bookmarked');
        label.textContent = '已收藏文章';
      } else {
        btn.classList.remove('bookmarked');
        label.textContent = '收藏文章';
      }
    }

    renderStatus();

    btn.addEventListener('click', (e) => {
      e.preventDefault();
      UserStore.toggleBookmarkArticle({
        slug,
        title,
        category,
        description,
        url,
        readTime
      });
      renderStatus();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBookmarkBtn);
  } else {
    initBookmarkBtn();
  }
</script>

<style>
  .guide-detail-page {
    padding-bottom: 72px;
  }

  .page-breadcrumbs {
    padding-top: 20px;
    padding-bottom: 12px;
  }
  .breadcrumb-list {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.86rem;
    color: var(--color-muted);
  }
  .breadcrumb-list a {
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .breadcrumb-list a:hover {
    color: var(--color-primary);
  }
  .breadcrumb-list .separator {
    color: var(--color-border);
  }
  .breadcrumb-list [aria-current="page"] {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .guide-header-banner {
    padding: 28px 0 36px 0;
    background: linear-gradient(180deg, rgba(235, 243, 255, 0.6) 0%, rgba(248, 251, 255, 0) 100%);
    border-bottom: 1px solid var(--color-border-light);
    margin-bottom: 40px;
  }
  .guide-meta-strip {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 16px;
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .btn-bookmark-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    padding: 5px 12px;
    border-radius: 999px;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-bookmark-action:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: #F0F5FF;
  }
  .btn-bookmark-action.bookmarked {
    background: #EEF4FF;
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .btn-bookmark-action.bookmarked .bookmark-svg {
    fill: var(--color-primary);
  }

  .guide-main-h1 {
    font-size: 2.1rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1.35;
    margin-bottom: 20px;
    letter-spacing: -0.02em;
  }

  .guide-summary-callout {
    display: flex;
    gap: 14px;
    padding: 16px 20px;
    background: #FFFFFF;
    border: 1px solid rgba(36, 84, 237, 0.2);
    border-left: 4px solid var(--color-primary);
    border-radius: var(--radius-md);
    margin-bottom: 20px;
    box-shadow: 0 2px 8px rgba(36, 84, 237, 0.04);
  }
  .summary-icon {
    color: var(--color-primary);
    flex-shrink: 0;
    padding-top: 2px;
  }
  .summary-text {
    font-size: 0.98rem;
    line-height: 1.65;
    color: #2D3748;
    margin: 0;
  }

  .guide-tags-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 0.84rem;
  }
  .tags-label {
    color: var(--color-muted);
    font-weight: 500;
  }
  .guide-kw-tag {
    display: inline-block;
    padding: 3px 9px;
    background: rgba(36, 84, 237, 0.06);
    color: var(--color-primary);
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 500;
  }

  .guide-body-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 340px;
    gap: 36px;
    align-items: start;
  }

  .guide-quick-toc {
    padding: 22px 24px;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    margin-bottom: 32px;
  }
  .toc-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 14px;
  }
  .toc-list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .toc-list li a {
    color: var(--color-text-secondary);
    text-decoration: none;
    font-size: 0.93rem;
    line-height: 1.45;
    transition: color 0.15s ease;
  }
  .toc-list li a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .guide-content-section {
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 32px 30px;
    margin-bottom: 28px;
    box-shadow: var(--shadow-sm);
  }
  .section-heading {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 0;
    margin-bottom: 18px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border-light);
  }

  .section-prose {
    font-size: 1rem;
    line-height: 1.75;
    color: #2D3748;
  }
  .section-prose :global(p) {
    margin: 0 0 16px 0;
  }
  .section-prose :global(ul),
  .section-prose :global(ol) {
    margin: 0 0 18px 0;
    padding-left: 24px;
  }
  .section-prose :global(li) {
    margin-bottom: 8px;
  }
  .section-prose :global(strong) {
    color: var(--color-text-primary);
    font-weight: 600;
  }
  .section-prose :global(code) {
    background: #F1F5F9;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 0.9em;
    color: #D946EF;
    font-family: monospace;
  }
  .section-prose :global(pre) {
    background: #1E293B;
    color: #E2E8F0;
    padding: 16px;
    border-radius: var(--radius-md);
    overflow-x: auto;
    margin: 16px 0;
  }
  .section-prose :global(pre code) {
    background: transparent;
    color: inherit;
    padding: 0;
  }
  .section-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    font-size: 0.92rem;
  }
  .section-prose :global(th),
  .section-prose :global(td) {
    border: 1px solid var(--color-border);
    padding: 10px 14px;
    text-align: left;
  }
  .section-prose :global(th) {
    background: #F8FAFC;
    color: var(--color-text-primary);
    font-weight: 600;
  }

  .faqs-accordion {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .guide-faq-item {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #FAFCFF;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }
  .guide-faq-item[open] {
    border-color: rgba(36, 84, 237, 0.4);
    background: #FFFFFF;
  }
  .faq-question {
    padding: 14px 18px;
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--color-text-primary);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 12px;
    user-select: none;
  }
  .faq-q-badge {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--color-primary);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
  }
  .faq-q-text {
    flex-grow: 1;
  }
  .faq-chevron {
    color: var(--color-muted);
    font-size: 1.1rem;
    transition: transform 0.2s ease;
  }
  .guide-faq-item[open] .faq-chevron {
    transform: rotate(180deg);
    color: var(--color-primary);
  }
  .faq-answer {
    padding: 0 18px 16px 52px;
    color: #4A5568;
    font-size: 0.94rem;
    line-height: 1.65;
  }
  .faq-answer p {
    margin: 0;
  }

  .guide-article-bottom-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-top: 16px;
    flex-wrap: wrap;
  }
