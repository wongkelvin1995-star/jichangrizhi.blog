---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getRiskWatchlist } from '../lib/brand-parser.ts';

const riskCases = getRiskWatchlist();

// SEO Metadata strictly per instruction
const pageTitle = "2027机场风险预警｜机场跑路风险、购买避坑与安全使用指南 - 机场日志";
const pageH1 = "机场风险预警与购买避坑指南";
const pageDescription = "机场日志整理机场行业常见风险防范指南，解析机场跑路风险识别信号、长期套餐购买注意事项、低价陷阱、订阅安全与个人隐私保护，提供真实客观的风险防范建议与案例参考。";
const canonicalPath = "/risk-alerts/";

// Risk Knowledge Center Topics
const riskKnowledgeTopics = [
  {
    icon: '🚨',
    title: '一、机场跑路风险识别信号',
    content: '机场在资金链断裂或停止运营前，通常会释放以下明显预警信号：① 突然开展违背市场规律的大幅度年付/多年付折扣促销；② 频繁更换支付通道或收款账户名称；③ 官方 Telegram 频道突然开启全员禁言或解散讨论群组；④ 工单系统超过 48 小时无人回复且客服离线；⑤ 大批核心专线节点出现长达数天的持续断流且无故障通告。发现上述征兆应立即停止续费并备份节点配置。'
  },
  {
    icon: '⏳',
    title: '二、长期套餐购买注意事项',
    content: '绝大多数机场跑路受害者都陷入了「年付省几十块钱」的心理陷阱。网络中继行业受国际出口网络、机房政策与汇率波动影响极大，绝少有中小型服务商具备超过 12 个月的抗风险兜底能力。强烈建议用户始终坚持【月付或季付】原则，将单次支付资金控制在个人可承受的试错范围内，切忌一次性购买 2 年或 3 年超级大包。'
  },
  {
    icon: '📉',
    title: '三、低价机场风险分析与超卖内幕',
    content: '市场上常见的「1元机场」或「9.9元包年」产品，其真实底层逻辑往往建立在【极致超卖】之上：将仅有 1Gbps 的带宽超额售卖给上万名用户。晚高峰必然面临断流与严重丢包；更有甚者，部分恶意低价站点通过收集用户注册的常用邮箱与密码进行撞库攻击，或在后端抓取用户的未加密流量。切记：优质网络带宽拥有刚性采购成本，过分廉价往往代价更高。'
  },
  {
    icon: '🔐',
    title: '四、订阅链接安全与防泄密规范',
    content: '机场订阅链接包含您账号的独立鉴权 Token。一旦将该链接暴露在公开聊天群、论坛或上传至公共代码仓库，第三方即可随时拉取您的节点并不受限制地消耗您的月度流量，甚至利用您的节点进行违规操作。请妥善保管订阅链接，切勿使用来源不明的公共在线订阅转换平台，若怀疑泄漏应立即在官网后台点击「重置订阅」。'
  },
  {
    icon: '🛡️',
    title: '五、个人隐私与支付安全防护',
    content: '注册机场账号时，建议遵循最小必要信息原则：① 严禁使用与日常工作生活相关的私人主邮箱，优先使用专用临时邮箱或 Outlook/Proton 等独立邮箱；② 密码必须设置为独立的高强度随机密码，避免与国内网站共用；③ 支付时优先选用虚拟卡或支持防关联的第三方支付方式，避免直接提交个人实名敏感信息。'
  },
  {
    icon: '⚖️',
    title: '六、退款与售后权益注意事项',
    content: '由于网络代理服务的特殊性，行业内绝大多数服务商在《服务条款 (TOS)》中均明确注明「虚拟数字化商品一旦售出概不退款」。在初次选购前，请仔细核阅商家的试用政策与退款保障条款。若遇到恶意跑路欺诈，请第一时间保留订单支付流水截图、官网页面快照及沟通记录，并通过原支付网关或发卡行申请交易调解申诉。'
  }
];

// Dedicated FAQ
const riskFaqs = [
  {
    q: "本专区的风险资讯来源是什么？如何保障客观真实性？",
    a: "本站收录的所有风险案例均来自公开透明的第三方技术开发者社区（如 GitHub limbopro/Paolujichang 开源追踪仓库）及多方用户的真实可复现报告。所有记录均保留了原始 Issue 索引号、首报时间及核实记录，严格区分「历史停运报告」与「异常观察中」，绝不凭个别差评编造负面谣言。"
  },
  {
    q: "什么情况下一个品牌会被标注为「服务异常观察中」？",
    a: "当某个机场在短时间内被多名用户集中反馈出现大面积节点超时、官网控制台无法访问或客服严重失联，但尚未能证实其为永久性关停（可能属于上游主干光缆故障或机房维护）时，本站会审慎标注为「持续观察中」，旨在提醒用户暂时观望，不草率定性。"
  },
  {
    q: "如果被收录的服务商已经恢复正常运营，该如何申请状态更新？",
    a: "我们设立了专门的澄清与纠错通道。服务商运营团队或用户只需提供可复现的节点可用性证明、官方群组公告及工单答复记录，发送邮件至 feedback@jichangrizhi.blog，技术团队将在 24 小时内核对并在档案中更新状态标签（如更新为已恢复）。"
  },
  {
    q: "面对机场异常或跑路风险，普通用户应该如何建立自救体系？",
    a: "老玩家的黄金法则是【双机场冗余配置】：日常使用主力优质月付专线保障工作与影音体验；同时购买一份不限时按量付费（如 50GB/¥20）的便宜冷备机场。一旦主力遇突发网络维护或异常，随时一键切换备用线路，绝不耽误日常业务。"
  },
  {
    q: "为什么机场跑路事件多集中在超低价和长期年付产品中？",
    a: "因为超低价模式无法覆盖真实的专线带宽和服务器折旧成本，往往依赖不断涌入的新用户资金填补老用户带宽消耗（类似庞氏资金盘），一旦新增用户放缓或遇到上游机房封禁，资金链便会瞬间断裂导致不得不关站跑路。"
  }
];

// JSON-LD Schemas
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: '首页',
      item: 'https://jichangrizhi.blog/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: '风险预警',
      item: 'https://jichangrizhi.blog/risk-alerts/'
    }
  ]
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: riskFaqs.map(faq => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath={canonicalPath}
  jsonLdSchema={[breadcrumbSchema, faqSchema]}
>
  <div class="risk-alerts-page">
    <!-- Breadcrumbs -->
    <nav class="page-breadcrumbs container" aria-label="面包屑导航">
      <ol class="breadcrumb-list">
        <li><a href="/">首页</a></li>
        <li class="separator">/</li>
        <li aria-current="page">风险预警</li>
      </ol>
    </nav>

    <!-- Header Banner -->
    <header class="page-header-banner">
      <div class="container">
        <div class="banner-badge-wrap">
          <span class="badge-tag warning">
            <span class="alert-pulse-dot"></span>
            安全避坑专区
          </span>
          <span class="badge-tag blue">客观记录 · 独立核实</span>
        </div>
        <h1 class="page-main-h1">{pageH1}</h1>
        <p class="page-intro-desc">
          机场日志整理机场行业常见风险防范指南，解析机场跑路风险识别信号、长期套餐购买注意事项、低价陷阱、订阅安全与个人隐私保护，提供真实客观的风险防范建议与案例参考。
        </p>

        <!-- Core Keyword Strip -->
        <div class="seo-keywords-strip">
          <span class="kw-label">关注要点：</span>
          <span class="kw-tag">机场风险</span>
          <span class="kw-tag">机场跑路</span>
          <span class="kw-tag">机场避坑</span>
          <span class="kw-tag">机场安全吗</span>
          <span class="kw-tag">机场购买注意事项</span>
          <span class="kw-tag">机场退款风险</span>
          <span class="kw-tag">机场订阅安全</span>
          <span class="kw-tag">机场怎么选</span>
        </div>

        <div class="disclaimer-callout-box">
          <div class="disclaimer-icon">ℹ</div>
          <div class="disclaimer-body">
            <strong>免责与客观性声明：</strong>
            本专区收录的历史停运报告及异常动态均基于公开第三方社区报告及多位用户反馈汇总整理，不作为对任何品牌的最终法律事实定性。偶发网络抖动或上游检修不代表永久停运，我们设立了及时的核实与更新通道。
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Container -->
    <main class="container risk-main-container">
      <!-- Section 1: Risk Knowledge Center (6 Topics) -->
      <section class="knowledge-center-section">
        <div class="section-heading-bar">
          <div class="section-heading-left">
            <span class="heading-accent-bar"></span>
            <h2 class="section-main-title">机场风险识别与安全避坑知识中心</h2>
            <span class="section-sub-desc">六大核心避坑法则，助您守住资金安全与网络隐私底线</span>
          </div>
        </div>

        <div class="knowledge-topics-grid">
          {riskKnowledgeTopics.map(topic => (
            <article class="journal-card knowledge-topic-card">
              <h3 class="topic-title">
                <span class="topic-icon">{topic.icon}</span>
                <span>{topic.title}</span>
              </h3>
              <p class="topic-content">{topic.content}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Section 2: Public Case Watchlist (4 Real Cases) -->
      <section class="public-cases-section">
        <div class="section-heading-bar">
          <div class="section-heading-left">
            <span class="heading-accent-bar"></span>
            <h2 class="section-main-title">公开社区异常报告与案例追踪参考</h2>
            <span class="section-sub-desc">来源于公开技术社区追踪 Issue 与多方反馈核验，持续更新</span>
          </div>
        </div>

        <div class="cases-grid">
          {riskCases.map(item => (
            <div class="journal-card case-card">
              <div class="case-card-header">
                <div class="case-title-row">
                  <h3 class="case-name">{item.name}</h3>
                  <span class={`status-pill ${item.categoryBadge === 'history-shutdown' ? 'danger' : 'warning'}`}>
                    {item.category}
                  </span>
                </div>
                <div class="case-dates">
                  <span>首报：{item.reportDate}</span>
                  <span class="dot-sep">·</span>
                  <span>核验：{item.lastVerifiedDate}</span>
                </div>
              </div>

              <div class="case-body">
                <p class="case-symptoms">
                  <strong>现象记录：</strong>{item.symptoms}
                </p>
                <p class="case-notes">
                  <strong>防范建议：</strong>{item.notes}
                </p>
              </div>

              <div class="case-footer">
                <div class="source-info">
                  <span class="source-label">线索来源：</span>
                  <a href={item.sourceUrl} target="_blank" rel="nofollow noopener noreferrer" class="source-link">
                    {item.sourceName} ↗
                  </a>
                </div>
                <span class="verify-tag">{item.status}</span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 3: Dedicated Risk FAQ (5 Questions) -->
      <section class="risk-faq-section">
        <div class="section-heading-bar">
          <div class="section-heading-left">
            <span class="heading-accent-bar"></span>
            <h2 class="section-main-title">机场安全与跑路防范常见问答 (FAQ)</h2>
            <span class="section-sub-desc">提炼老玩家与安全专家的实战经验，解答关于资金与隐私的疑难</span>
          </div>
        </div>

        <div class="risk-faq-grid">
          {riskFaqs.map((faq, index) => (
            <div class="journal-card risk-faq-card">
              <h3 class="faq-question">
                <span class="faq-q-mark">Q{index + 1}.</span>
                {faq.q}
              </h3>
              <p class="faq-answer">{faq.a}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Section 4: Correction & Feedback Box -->
      <section class="journal-card feedback-box">
        <div class="feedback-icon">✉</div>
        <div class="feedback-text-wrap">
          <h3 class="feedback-title">发现服务商已恢复正常或有最新线索？</h3>
          <p class="feedback-desc">
            若您是被收录品牌的运营人员或使用该服务的用户，且该品牌已经恢复稳定运行或完成机房割接，欢迎向我们提交最新工单答复或节点测速证明。核验属实后我们将在 24 小时内更新观察状态。
          </p>
        </div>
        <div class="feedback-action">
          <a href="mailto:feedback@jichangrizhi.blog?subject=风险预警专区更新反馈" class="btn-feedback">
            提交状态更新申请 →
          </a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  .risk-alerts-page {
    padding-bottom: 72px;
  }

  /* Breadcrumbs */
  .page-breadcrumbs {
    padding-top: 20px;
    padding-bottom: 12px;
  }
  .breadcrumb-list {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--color-text-secondary);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .breadcrumb-list a {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .breadcrumb-list a:hover {
    color: var(--color-primary);
  }
  .breadcrumb-list .separator {
    color: #BDC5D0;
  }

  /* Header Banner */
  .page-header-banner {
    padding: 32px 0 28px 0;
    background: linear-gradient(180deg, rgba(254, 242, 242, 0.5) 0%, rgba(255, 255, 255, 0) 100%);
    border-bottom: 1px solid rgba(226, 232, 240, 0.6);
  }
  .banner-badge-wrap {
    display: flex;
    gap: 10px;
    margin-bottom: 16px;
  }
  .alert-pulse-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    background: #E11D48;
    border-radius: 50%;
    margin-right: 5px;
    animation: pulse 1.8s infinite;
  }
  @keyframes pulse {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(1.3); }
    100% { opacity: 1; transform: scale(1); }
  }

  .page-main-h1 {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 14px;
    line-height: 1.25;
  }
  .page-intro-desc {
    font-size: 16px;
    color: var(--color-text-secondary);
    max-width: 860px;
    line-height: 1.65;
    margin-bottom: 18px;
  }

  .seo-keywords-strip {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
    font-size: 13px;
  }
  .kw-label {
    color: var(--color-text-muted);
    font-weight: 600;
  }
  .kw-tag {
    background: #F1F5F9;
    color: #475569;
    padding: 2px 9px;
    border-radius: 6px;
    font-weight: 500;
  }

  .disclaimer-callout-box {
    display: flex;
    gap: 14px;
    padding: 16px 20px;
    background: #FFFBEB;
    border: 1px solid #FDE68A;
    border-radius: var(--radius-card);
    font-size: 13.5px;
    color: #92400E;
    line-height: 1.6;
    max-width: 920px;
  }
  .disclaimer-icon {
    font-size: 18px;
    font-weight: 800;
    flex-shrink: 0;
  }

  /* Main Container */
  .risk-main-container {
    padding-top: 36px;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* Knowledge Center */
  .knowledge-topics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 24px;
    margin-top: 24px;
  }
  .knowledge-topic-card {
    padding: 24px;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .knowledge-topic-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-sm);
    border-color: #CBD5E1;
  }
  .topic-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 12px 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .topic-icon {
    font-size: 18px;
  }
  .topic-content {
    font-size: 14px;
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  /* Cases Grid */
  .cases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 20px;
    margin-top: 24px;
  }
  .case-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
  }
  .case-card-header {
    margin-bottom: 14px;
  }
  .case-title-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
  }
  .case-name {
    font-size: 18px;
    font-weight: 700;
    margin: 0;
    color: var(--color-text-primary);
  }
  .status-pill {
    font-size: 12px;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 600;
  }
  .status-pill.danger {
    background: #FEE2E2;
    color: #DC2626;
  }
  .status-pill.warning {
    background: #FEF3C7;
    color: #D97706;
  }
  .case-dates {
    font-size: 12px;
    color: var(--color-text-muted);
  }
  .dot-sep {
    margin: 0 4px;
  }
  .case-body {
    flex-grow: 1;
    margin-bottom: 16px;
  }
  .case-symptoms, .case-notes {
    font-size: 13.5px;
    color: var(--color-text-secondary);
    line-height: 1.6;
    margin: 0 0 8px 0;
  }
  .case-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 12px;
    border-top: 1px solid #F1F5F9;
    font-size: 12.5px;
  }
  .source-info {
    color: var(--color-text-muted);
  }
  .source-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 500;
  }
  .source-link:hover {
    text-decoration: underline;
  }
  .verify-tag {
    color: #64748B;
    background: #F1F5F9;
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 11px;
    font-weight: 600;
  }

  /* FAQ */
  .risk-faq-grid {
