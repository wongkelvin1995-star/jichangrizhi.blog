---
import PersonalCenterLayout from '../../layouts/PersonalCenterLayout.astro';
---

<PersonalCenterLayout
  title="更新通知 · 个人中心 MAX - 机场日志"
  description="实时接收 2027 机场日志的品牌收录变动、套餐资费调整、客户端教程发布与安全风险通告。"
  activeTab="notifications"
  pageHeading="更新通知"
>
  <div class="personal-subpage-wrap">
    <!-- Subpage Action Bar -->
    <header class="subpage-header-card journal-card">
      <div class="subpage-header-left">
        <div class="title-with-count">
          <h1 class="subpage-main-h1">系统动态与资讯通报</h1>
          <span class="count-tag" id="notifUnreadCountTag">0 未读</span>
        </div>
        <p class="subpage-desc">
          真实记录机场品牌入驻、套餐资费变动、实战教程更新与突发安全风险预警。
        </p>
      </div>

      <div class="subpage-header-controls">
        <button type="button" id="btnMarkAllRead" class="btn-mark-all-read">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
          <span>全部标为已读</span>
        </button>
      </div>
    </header>

    <!-- Filter Buttons Bar -->
    <div class="notif-filter-strip journal-card">
      <span class="filter-label">筛选类型：</span>
      <div class="filter-btn-group" id="notifFilterGroup">
        <button type="button" class="filter-pill active" data-type="all">全部动态</button>
        <button type="button" class="filter-pill" data-type="brand">品牌新增</button>
        <button type="button" class="filter-pill" data-type="price">资费变动</button>
        <button type="button" class="filter-pill" data-type="guide">指南教程</button>
        <button type="button" class="filter-pill" data-type="risk">安全预警</button>
      </div>
    </div>

    <!-- Notifications List -->
    <main class="notifications-list-wrap" id="notificationsList">
      <!-- Rendered dynamically via JS -->
    </main>
  </div>
</PersonalCenterLayout>

<script>
  import { UserStore, type UserNotification } from '../../lib/user-store.ts';

  const listContainer = document.getElementById('notificationsList');
  const countTag = document.getElementById('notifUnreadCountTag');
  const markAllBtn = document.getElementById('btnMarkAllRead');
  const filterBtns = document.querySelectorAll('#notifFilterGroup .filter-pill') as NodeListOf<HTMLButtonElement>;

  let activeType = 'all';

  const TYPE_NAMES: Record<string, { label: string; class: string }> = {
    brand: { label: '品牌新增', class: 'brand' },
    price: { label: '资费变动', class: 'price' },
    guide: { label: '指南教程', class: 'guide' },
    risk: { label: '安全预警', class: 'risk' }
  };

  function renderNotifications() {
    const list = UserStore.getNotifications();
    const unreadCount = list.filter(n => !n.read).length;

    if (countTag) {
      countTag.textContent = `${unreadCount} 未读`;
      if (unreadCount === 0) {
        countTag.style.background = '#F1F5F9';
        countTag.style.color = '#64748B';
      } else {
        countTag.style.background = '#FEE2E2';
        countTag.style.color = '#EF4444';
      }
    }

    const filtered = list.filter(item => {
      if (activeType === 'all') return true;
      return item.type === activeType;
    });

    if (listContainer) {
      if (filtered.length === 0) {
        listContainer.innerHTML = `
          <div class="journal-card empty-state-box">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#94A3B8" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
            </svg>
            <p>当前分类下暂无通知通报。</p>
          </div>
        `;
        return;
      }

      listContainer.innerHTML = filtered.map(item => {
        const typeInfo = TYPE_NAMES[item.type] || { label: '系统通知', class: 'brand' };
        return `
          <article class="journal-card notif-card ${item.read ? 'read' : 'unread'}" data-id="${item.id}">
            <div class="notif-card-header">
              <div class="notif-header-left">
                <span class="notif-type-pill ${typeInfo.class}">${typeInfo.label}</span>
                ${!item.read 
                  ? '<span class="notif-status-badge unread"><span class="unread-pulse-dot"></span>未读</span>' 
                  : '<span class="notif-status-badge read">已读</span>'}
              </div>
              <div class="notif-date-badge">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="16" y1="2" x2="16" y2="6"></line>
                  <line x1="8" y1="2" x2="8" y2="6"></line>
                  <line x1="3" y1="10" x2="21" y2="10"></line>
                </svg>
                <span>${item.date}</span>
              </div>
            </div>

            <h3 class="notif-card-title">${item.title}</h3>

            <p class="notif-content-text">${item.content}</p>

            <div class="notif-card-footer">
              <div class="notif-footer-action">
                ${item.relatedBrandId ? `<a href="/airports/${item.relatedBrandId}/" class="notif-link-btn">查看对应品牌档案 <span>→</span></a>` : ''}
                ${item.type === 'guide' ? `<a href="/guides/" class="notif-link-btn">前往指南知识中心 <span>→</span></a>` : ''}
                ${item.type === 'risk' ? `<a href="/risk-alerts/" class="notif-link-btn">查看风险预警专区 <span>→</span></a>` : ''}
              </div>
              <button type="button" class="btn-toggle-read ${item.read ? 'btn-read' : 'btn-unread'}" data-id="${item.id}">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>${item.read ? '标为未读' : '标为已读'}</span>
              </button>
            </div>
          </article>
        `;
      }).join('');

      // Bind read toggles
      listContainer.querySelectorAll('.btn-toggle-read').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = (btn as HTMLElement).dataset.id!;
          const currentList = UserStore.getNotifications();
          const target = currentList.find(n => n.id === id);
          if (target) {
            if (target.read) {
              const updated = currentList.map(n => n.id === id ? { ...n, read: false } : n);
              localStorage.setItem('airport_journal_notifications', JSON.stringify(updated));
              window.dispatchEvent(new CustomEvent('aj-user-store-updated', { detail: { key: 'notifications' } }));
            } else {
              UserStore.markNotificationRead(id);
            }
            renderNotifications();
          }
        });
      });
    }
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeType = btn.dataset.type || 'all';
      renderNotifications();
    });
  });

  if (markAllBtn) {
    markAllBtn.addEventListener('click', () => {
      UserStore.markAllNotificationsRead();
      renderNotifications();
    });
  }

  renderNotifications();
  window.addEventListener('aj-user-store-updated', () => {
    renderNotifications();
  });
</script>

<style is:global>
  .personal-subpage-wrap {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  /* Subpage Header Card */
  .subpage-header-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 24px 28px;
    background: #FFFFFF;
    border: 1px solid #DFE7F1;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(20, 43, 72, 0.04);
    flex-wrap: wrap;
  }
  .subpage-header-left {
    max-width: 520px;
  }
  .title-with-count {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 6px;
  }
  .subpage-main-h1 {
    font-size: 21px;
    font-weight: 800;
    color: #142B48;
    margin: 0;
    letter-spacing: -0.01em;
  }
  .count-tag {
    font-size: 12.5px;
    font-weight: 700;
    padding: 3px 10px;
    border-radius: 20px;
    transition: all 0.2s ease;
  }
  .subpage-desc {
    font-size: 13.5px;
    color: #647B95;
    margin: 0;
    line-height: 1.5;
  }

  .btn-mark-all-read {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 18px;
    background: #F0F5FB;
    border: 1px solid #DFE7F1;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    color: #142B48;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .btn-mark-all-read:hover {
    background: #2454ED;
    border-color: #2454ED;
    color: #FFFFFF;
  }

  /* Filter Strip */
  .notif-filter-strip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 20px;
    background: #FFFFFF;
    border: 1px solid #DFE7F1;
    border-radius: 12px;
    flex-wrap: wrap;
  }
  .filter-label {
    font-size: 13px;
    font-weight: 600;
    color: #647B95;
  }
  .filter-btn-group {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .filter-pill {
    padding: 6px 14px;
    background: #F0F5FB;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    color: #647B95;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .filter-pill:hover {
    background: #E2EBF5;
    color: #142B48;
  }
  .filter-pill.active {
    background: #2454ED;
    color: #FFFFFF;
  }

  /* Empty state */
  .empty-state-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 20px;
    gap: 12px;
    color: #647B95;
    font-size: 14px;
  }
  .empty-state-box p {
    margin: 0;
  }

  /* Notifications List & Card Styling */
  .notifications-list-wrap {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .notif-card {
    background: #FFFFFF;
    border: 1px solid #DFE7F1;
    border-radius: 14px;
    padding: 20px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    box-shadow: 0 2px 8px rgba(20, 43, 72, 0.03);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }

  .notif-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(36, 84, 237, 0.06);
    border-color: #CBD5E1;
  }

  .notif-card.unread {
    border-left: 4px solid #2454ED;
    background: #FAFDFE;
  }

  .notif-card.read {
    border-left: 4px solid #DFE7F1;
    background: #FFFFFF;
    opacity: 0.88;
  }

  /* Card Top Row */
  .notif-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .notif-header-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .notif-type-pill {
    font-size: 12px;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: 6px;
    letter-spacing: 0.01em;
  }
  .notif-type-pill.brand {
    background: #E8F0FE;
    color: #2454ED;
  }
  .notif-type-pill.price {
    background: #FEF3C7;
    color: #B45309;
  }
  .notif-type-pill.guide {
    background: #DCFCE7;
    color: #15803D;
  }
  .notif-type-pill.risk {
    background: #FEE2E2;
    color: #DC2626;
  }

  .notif-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 11.5px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 6px;
  }
  .notif-status-badge.unread {
    background: #FEE2E2;
    color: #EF4444;
  }
  .notif-status-badge.read {
    background: #F1F5F9;
    color: #64748B;
  }

  .unread-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #EF4444;
    display: inline-block;
  }

  .notif-date-badge {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 12.5px;
    color: #647B95;
    font-weight: 500;
  }

  /* Title & Content */
  .notif-card-title {
    font-size: 16px;
    font-weight: 700;
    color: #142B48;
    line-height: 1.45;
    margin: 4px 0 2px 0;
  }

  .notif-card.read .notif-card-title {
    color: #334155;
  }

  .notif-content-text {
    font-size: 13.8px;
    color: #475569;
    line-height: 1.65;
    margin: 0;
  }

  /* Card Footer Actions */
  .notif-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    margin-top: 4px;
    border-top: 1px solid #F1F5F9;
    gap: 12px;
    flex-wrap: wrap;
  }

  .notif-footer-action {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .notif-link-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 13.5px;
    font-weight: 600;
    color: #2454ED;
    text-decoration: none;
    transition: all 0.15s ease;
  }
  .notif-link-btn span {
    transition: transform 0.2s ease;
  }
  .notif-link-btn:hover {
    color: #173B9C;
  }
  .notif-link-btn:hover span {
    transform: translateX(3px);
  }

  .btn-toggle-read {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    margin-left: auto;
    border: 1px solid #DFE7F1;
    background: #FFFFFF;
    color: #647B95;
  }
  .btn-toggle-read:hover {
    border-color: #2454ED;
    color: #2454ED;
    background: #F0F5FB;
  }
  .btn-toggle-read.btn-read {
    background: #F8FAFC;
    color: #94A3B8;
  }
  .btn-toggle-read.btn-read:hover {
    color: #475569;
    background: #F1F5F9;
  }
</style>
