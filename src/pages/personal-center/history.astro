---
import PersonalCenterLayout from '../../layouts/PersonalCenterLayout.astro';
---

<PersonalCenterLayout
  title="浏览记录 · 个人中心 MAX - 机场日志"
  description="查看您在 2027 机场日志的浏览足迹，随时重访机场档案与实战使用教程。"
  activeTab="history"
  pageHeading="浏览记录"
>
  <div class="personal-subpage-wrap">
    <!-- Subpage Action Bar -->
    <header class="subpage-header-card journal-card">
      <div class="subpage-header-left">
        <div class="title-with-count">
          <h1 class="subpage-main-h1">浏览足迹记录</h1>
          <span class="count-tag" id="histTotalCountTag">0</span>
        </div>
        <p class="subpage-desc">
          自动保存您最近访问的 100 条机场档案与技术指南。数据仅存储于本机，可随时一键清空或关闭记录。
        </p>
      </div>

      <div class="subpage-header-controls">
        <button type="button" id="btnClearAllHistory" class="btn-clear-danger" title="清空所有记录">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
          <span>清空全部足迹</span>
        </button>
      </div>
    </header>

    <!-- History List Stack -->
    <main class="history-list-wrap journal-card" id="historyListContainer">
      <!-- Rendered dynamically via JS -->
    </main>

    <!-- Empty State Placeholder -->
    <div id="historyEmptyState" class="empty-state-box journal-card" style="display: none;">
      <div class="empty-icon-circle">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#2454ED" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <polyline points="12 6 12 12 16 14"></polyline>
        </svg>
      </div>
      <h2 class="empty-title">暂无浏览足迹</h2>
      <p class="empty-desc">
        您尚未在当前浏览器浏览过任何机场档案或指南页面，或足迹记录功能已被关闭。
      </p>
      <div class="empty-actions">
        <a href="/airports/" class="btn-empty-primary">
          <span>浏览机场档案</span>
        </a>
      </div>
    </div>
  </div>
</PersonalCenterLayout>

<script>
  import { UserStore } from '../../lib/user-store.ts';

  const listContainer = document.getElementById('historyListContainer');
  const emptyBox = document.getElementById('historyEmptyState');
  const countTag = document.getElementById('histTotalCountTag');
  const clearBtn = document.getElementById('btnClearAllHistory');

  function formatTime(timestamp: number): string {
    const d = new Date(timestamp);
    const now = new Date();
    const isToday = d.toDateString() === now.toDateString();
    const timeStr = d.toLocaleTimeString('zh-CN', { hour: '2-digit', minute: '2-digit' });
    if (isToday) {
      return `今天 ${timeStr}`;
    }
    const dateStr = d.toLocaleDateString('zh-CN', { month: 'numeric', day: 'numeric' });
    return `${dateStr} ${timeStr}`;
  }

  function renderHistory() {
    const list = UserStore.getHistory();
    if (countTag) countTag.textContent = String(list.length);

    if (list.length === 0) {
      if (listContainer) listContainer.style.display = 'none';
      if (emptyBox) emptyBox.style.display = 'flex';
      return;
    }

    if (emptyBox) emptyBox.style.display = 'none';
    if (listContainer) {
      listContainer.style.display = 'flex';
      listContainer.innerHTML = list.map(item => {
        return `
          <div class="history-item-row">
            <div class="hist-left-col">
              <span class="type-pill ${item.type}">${item.typeName || '网页'}</span>
              <a href="${item.url}" class="hist-title-link">${item.title}</a>
            </div>
            <div class="hist-right-col">
              <span class="hist-time">${formatTime(item.visitedAt)}</span>
              <button
                type="button"
                class="btn-del-single-hist"
                data-url="${item.url}"
                title="删除此条记录"
                aria-label="删除此条记录"
              >
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="18" y1="6" x2="6" y2="18"></line>
                  <line x1="6" y1="6" x2="18" y2="18"></line>
                </svg>
              </button>
            </div>
          </div>
        `;
      }).join('');

      // Bind single delete
      listContainer.querySelectorAll('.btn-del-single-hist').forEach(btn => {
        btn.addEventListener('click', () => {
          const u = (btn as HTMLElement).dataset.url!;
          UserStore.removeHistoryItem(u);
          renderHistory();
        });
      });
    }
  }

  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      const confirmed = window.confirm('确定要清空全部浏览足迹吗？此操作不可撤销。');
      if (confirmed) {
        UserStore.clearHistory();
        renderHistory();
      }
    });
  }

  renderHistory();
  window.addEventListener('aj-user-store-updated', () => {
    renderHistory();
  });
</script>

<style is:global>
  .personal-subpage-wrap {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Subpage Header Card */
  .subpage-header-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 24px 28px;
    background: #FFFFFF;
    border: 1px solid #DFE7F1;
    border-radius: 16px;
    box-shadow: 0 2px 8px rgba(20, 43, 72, 0.04);
    flex-wrap: wrap;
  }
  .subpage-header-left {
    max-width: 500px;
  }
  .title-with-count {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }
  .subpage-main-h1 {
    font-size: 20px;
    font-weight: 800;
    color: #142B48;
    margin: 0;
  }
  .count-tag {
    font-size: 13px;
    font-weight: 700;
    color: #2454ED;
    background: #E8F0FE;
    padding: 2px 9px;
    border-radius: 12px;
  }
  .subpage-desc {
    font-size: 13.5px;
    color: #647B95;
    margin: 0;
  }

  .btn-clear-danger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 9px 16px;
    background: #FFF1F2;
    border: 1px solid #FECDD3;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    color: #E11D48;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-clear-danger:hover {
    background: #FFE4E6;
    border-color: #FDA4AF;
  }

  /* History List */
  .history-list-wrap {
    background: #FFFFFF;
    border: 1px solid #DFE7F1;
    border-radius: 16px;
    padding: 12px 24px;
    box-shadow: 0 2px 8px rgba(20, 43, 72, 0.04);
    display: flex;
    flex-direction: column;
  }
  .history-item-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid #F0F5FB;
    transition: background 0.15s ease;
  }
  .history-item-row:last-child {
    border-bottom: none;
  }
  .hist-left-col {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .hist-title-link {
    font-size: 14.5px;
    font-weight: 600;
    color: #142B48;
    text-decoration: none;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    transition: color 0.15s ease;
  }
  .hist-title-link:hover {
    color: #2454ED;
  }
  .hist-right-col {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }
  .hist-time {
    font-size: 12.5px;
    color: #94A3B8;
  }
  .btn-del-single-hist {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    background: #F8FAFD;
    border: 1px solid #EDF2F7;
    color: #94A3B8;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .btn-del-single-hist:hover {
    background: #FEE2E2;
    border-color: #FECDD3;
    color: #EF4444;
  }

  .type-pill {
    font-size: 11px;
    padding: 2px 7px;
    border-radius: 6px;
    font-weight: 600;
    flex-shrink: 0;
  }
  .type-pill.brand {
    background: #E8F0FE;
    color: #2454ED;
  }
  .type-pill.guide {
    background: #DCFCE7;
    color: #166534;
  }
  .type-pill.risk {
    background: #FEE2E2;
    color: #991B1B;
  }
  .type-pill.page {
    background: #F1F5F9;
    color: #475569;
  }

  /* Empty State */
  .empty-state-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 56px 24px;
    text-align: center;
    background: #FFFFFF;
    border: 1px solid #DFE7F1;
    border-radius: 18px;
    box-shadow: 0 2px 8px rgba(20, 43, 72, 0.04);
  }
  .empty-icon-circle {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    background: #EFF6FF;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 20px;
  }
  .empty-title {
    font-size: 18px;
    font-weight: 800;
    color: #142B48;
    margin: 0 0 8px 0;
  }
  .empty-desc {
    font-size: 14px;
    color: #647B95;
    max-width: 480px;
    line-height: 1.6;
    margin: 0 0 24px 0;
  }
  .btn-empty-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    background: #2454ED;
    color: #FFFFFF;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.15s ease;
    box-shadow: 0 4px 12px rgba(36, 84, 237, 0.25);
  }
  .btn-empty-primary:hover {
    background: #173B9C;
    transform: translateY(-1px);
  }
</style>
