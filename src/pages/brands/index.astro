  /* Cross Navigation Note */
  .directory-cross-nav {
    margin-top: 48px;
    padding: 24px 32px;
    background: #FFFFFF;
    border: 1px solid #D8E7FD;
    border-radius: var(--radius-card);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }
  .cross-nav-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--color-text-primary);
    margin: 0 0 6px 0;
  }
  .cross-nav-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0;
    line-height: 1.5;
  }
  .btn-cross-archive {
    display: inline-block;
    padding: 11px 22px;
    background: var(--color-primary);
    color: #FFFFFF;
    font-size: 13.5px;
    font-weight: 600;
    border-radius: var(--radius-btn);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.15s ease;
  }
  .btn-cross-archive:hover {
    background: #1B4FD8;
  }

  @media (max-width: 768px) {
    .page-main-h1 {
      font-size: 24px;
    }
    .brand-cards-grid {
      grid-template-columns: 1fr;
    }
    .directory-cross-nav {
      flex-direction: column;
      align-items: flex-start;
      padding: 20px;
    }
  }
</style>
