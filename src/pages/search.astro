---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildSearchIndex } from '../lib/search-indexer.ts';

// Pre-render the full search index into page JSON for instant zero-latency client search
const searchIndex = buildSearchIndex();

const pageTitle = "全站搜索 - 2027 机场日志";
const pageDescription = "搜索 2027 机场日志收录的全部机场品牌、套餐资费、节点地区、客户端教程、风险预警与技术指南。";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalPath="/search/"
  robots="noindex, follow"
>
  <div class="search-page-wrapper">
    <!-- Header Banner -->
    <section class="page-intro-banner">
      <div class="container">
        <div class="banner-badge-wrap">
          <span class="badge-tag blue">全站即时检索</span>
          <span class="badge-tag success">覆盖品牌、套餐、指南与风险</span>
        </div>
        <h1 class="page-main-h1">全站搜索</h1>
        <p class="page-intro-desc">
          支持品牌名称、套餐资费、付款周期（年付/月付）、流量规格（100GB/500GB/不限时）、客户端（Clash/小火箭）、AI/流媒体（ChatGPT/Netflix）及节点地区快速查找。
        </p>

        <!-- Big Search Bar -->
        <div class="page-search-bar-wrap">
          <div class="page-search-box">
            <svg class="search-svg-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <input
              type="search"
              id="mainSearchPageInput"
              class="page-search-input"
              placeholder="搜索机场、品牌、套餐、关键词..."
              autocomplete="off"
              autofocus
            />
            <button type="button" id="mainSearchClearBtn" class="search-clear-btn" aria-label="清空输入" style="display: none;">
              ✕
            </button>
          </div>
        </div>

        <!-- Hot Search Suggestions -->
        <div class="hot-search-tags-row">
          <span class="hot-search-label">热搜建议：</span>
          <div class="hot-tags-list">
            <button type="button" class="hot-tag-btn" data-query="灵动云">灵动云</button>
            <button type="button" class="hot-tag-btn" data-query="暮光加速">暮光加速</button>
            <button type="button" class="hot-tag-btn" data-query="微风网络">微风网络</button>
            <button type="button" class="hot-tag-btn" data-query="大佬云">大佬云</button>
            <button type="button" class="hot-tag-btn" data-query="飞V">飞V</button>
            <button type="button" class="hot-tag-btn" data-query="便宜机场">便宜机场</button>
            <button type="button" class="hot-tag-btn" data-query="Clash">Clash</button>
            <button type="button" class="hot-tag-btn" data-query="年付">年付</button>
            <button type="button" class="hot-tag-btn" data-query="月付">月付</button>
            <button type="button" class="hot-tag-btn" data-query="100GB">100GB</button>
            <button type="button" class="hot-tag-btn" data-query="500GB">500GB</button>
            <button type="button" class="hot-tag-btn" data-query="不限时">不限时</button>
            <button type="button" class="hot-tag-btn" data-query="ChatGPT">ChatGPT</button>
            <button type="button" class="hot-tag-btn" data-query="Netflix">Netflix</button>
            <button type="button" class="hot-tag-btn" data-query="香港">香港</button>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Results Section -->
    <section class="container search-results-container">
      <!-- Category Tabs Filter -->
      <div class="search-tabs-bar" id="searchTabsBar" style="display: none;">
        <button type="button" class="search-tab-item active" data-tab="all">
          全部结果 <span class="tab-count" id="count-all">0</span>
        </button>
        <button type="button" class="search-tab-item" data-tab="brand">
          机场品牌 <span class="tab-count" id="count-brand">0</span>
        </button>
        <button type="button" class="search-tab-item" data-tab="plan">
          机场套餐 <span class="tab-count" id="count-plan">0</span>
        </button>
        <button type="button" class="search-tab-item" data-tab="guide">
          使用指南 <span class="tab-count" id="count-guide">0</span>
        </button>
        <button type="button" class="search-tab-item" data-tab="article">
          专题文章 <span class="tab-count" id="count-article">0</span>
        </button>
        <button type="button" class="search-tab-item" data-tab="risk">
          风险预警 <span class="tab-count" id="count-risk">0</span>
        </button>
      </div>

      <!-- Results List Grid -->
      <div id="searchResultsList" class="search-results-list"></div>

      <!-- Empty State -->
      <div id="searchEmptyState" class="search-empty-card" style="display: none;">
        <div class="empty-icon-box">🔍</div>
        <h2 class="empty-title">暂未找到相关内容</h2>
        <p class="empty-desc">
          请尝试其他品牌名称、套餐名称或关键词（例如：灵动云、年付、Clash、香港、不限时）。
        </p>
        <div class="empty-actions">
          <a href="/airports/" class="btn btn-primary">
            浏览品牌目录索引 →
          </a>
          <a href="/" class="btn btn-secondary">
            返回首页档案全文
          </a>
        </div>
      </div>

      <!-- Initial / Idle State -->
      <div id="searchInitialState" class="search-idle-card">
        <p>💡 请在上方搜索框输入关键词，或点击热搜建议标签即刻检索全站 160+ 条档案与套餐数据。</p>
      </div>
    </section>
  </div>
</BaseLayout>

<!-- Inject search index JSON into window for client-side search -->
<script define:vars={{ searchIndex }}>
  window.__SEARCH_INDEX__ = searchIndex;
</script>

<script>
  import { searchSite } from '../lib/search-engine.ts';

  const searchIndex = (window as any).__SEARCH_INDEX__ || [];
  const searchInput = document.getElementById('mainSearchPageInput') as HTMLInputElement | null;
  const clearBtn = document.getElementById('mainSearchClearBtn');
  const tabsBar = document.getElementById('searchTabsBar');
  const resultsContainer = document.getElementById('searchResultsList');
  const emptyState = document.getElementById('searchEmptyState');
  const initialState = document.getElementById('searchInitialState');

  let activeTab = 'all';
  let currentGrouped: any = null;
  let debounceTimer: any = null;

  function renderResults() {
    if (!currentGrouped || currentGrouped.total === 0) {
      if (tabsBar) tabsBar.style.display = 'none';
      if (resultsContainer) resultsContainer.innerHTML = '';
      if (emptyState) emptyState.style.display = 'block';
      if (initialState) initialState.style.display = 'none';
      return;
    }

    if (emptyState) emptyState.style.display = 'none';
    if (initialState) initialState.style.display = 'none';
    if (tabsBar) tabsBar.style.display = 'flex';

    // Update tab counts
    document.getElementById('count-all')!.innerText = String(currentGrouped.total);
    document.getElementById('count-brand')!.innerText = String(currentGrouped.brands.length);
    document.getElementById('count-plan')!.innerText = String(currentGrouped.plans.length);
    document.getElementById('count-guide')!.innerText = String(currentGrouped.guides.length);
    document.getElementById('count-article')!.innerText = String(currentGrouped.articles.length);
    document.getElementById('count-risk')!.innerText = String(currentGrouped.risks.length);

    // Get filtered list by activeTab
    let listToShow = currentGrouped.all;
    if (activeTab === 'brand') listToShow = currentGrouped.brands;
    else if (activeTab === 'plan') listToShow = currentGrouped.plans;
    else if (activeTab === 'guide') listToShow = currentGrouped.guides;
    else if (activeTab === 'article') listToShow = currentGrouped.articles;
    else if (activeTab === 'risk') listToShow = currentGrouped.risks;

    if (listToShow.length === 0) {
      if (resultsContainer) {
        resultsContainer.innerHTML = `
          <div class="tab-empty-msg">
            当前分类下无匹配结果，可切换至「全部结果」查看。
          </div>
        `;
      }
      return;
    }

    let html = '';
    listToShow.forEach((r: any) => {
      const item = r.item;
      const typeClass = item.type;
      const badgeText = item.badge || item.typeName;

      html += `
        <article class="journal-card search-result-card" data-type="${typeClass}">
          <div class="result-header">
            <span class="badge-tag result-type-tag ${typeClass}">${item.typeName}</span>
            ${badgeText ? `<span class="badge-tag blue">${badgeText}</span>` : ''}
            ${item.price ? `<span class="badge-tag result-price-badge">${item.price}</span>` : ''}
          </div>
          <h2 class="result-title">
            <a href="${item.url}" class="result-title-link">
              ${r.highlightedTitle}
            </a>
          </h2>
          ${r.highlightedSubtitle ? `<div class="result-subtitle">${r.highlightedSubtitle}</div>` : ''}
          <p class="result-snippet">${r.highlightedSnippet}</p>
          <div class="result-footer">
            <div class="result-tags">
              ${item.tags.slice(0, 5).map((t: string) => `<span class="result-tag-chip">${t}</span>`).join('')}
            </div>
            <a href="${item.url}" class="result-jump-btn">
              查看详情 →
            </a>
          </div>
        </article>
      `;
    });

    if (resultsContainer) {
      resultsContainer.innerHTML = html;
    }
  }

  function executeSearch(query: string) {
    const q = query.trim();
    if (!q) {
      currentGrouped = null;
      if (tabsBar) tabsBar.style.display = 'none';
      if (resultsContainer) resultsContainer.innerHTML = '';
      if (emptyState) emptyState.style.display = 'none';
      if (initialState) initialState.style.display = 'block';
      if (clearBtn) clearBtn.style.display = 'none';
      return;
    }

    if (clearBtn) clearBtn.style.display = 'block';
    currentGrouped = searchSite(searchIndex, q);
    renderResults();

    // Update URL query parameter silently
    const newUrl = new URL(window.location.href);
    newUrl.searchParams.set('q', q);
    window.history.replaceState({}, '', newUrl.toString());
  }

  // Handle Search Input with 150ms debounce
  if (searchInput) {
    searchInput.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        executeSearch(searchInput.value);
      }, 150);
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        searchInput.value = '';
        executeSearch('');
        searchInput.focus();
      });
    }

    // Read initial URL parameter ?q=...
    const urlParams = new URLSearchParams(window.location.search);
    const initialQuery = urlParams.get('q');
    if (initialQuery) {
      searchInput.value = initialQuery;
      executeSearch(initialQuery);
    }
  }

  // Handle Tab Switch
  document.querySelectorAll('.search-tab-item').forEach(tabBtn => {
    tabBtn.addEventListener('click', () => {
      document.querySelectorAll('.search-tab-item').forEach(b => b.classList.remove('active'));
      tabBtn.classList.add('active');
      activeTab = tabBtn.getAttribute('data-tab') || 'all';
      renderResults();
    });
  });

  // Handle Hot Search Tag Clicks
  document.querySelectorAll('.hot-tag-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const query = btn.getAttribute('data-query') || '';
      if (searchInput) {
        searchInput.value = query;
        executeSearch(query);
        searchInput.focus();
      }
    });
  });
</script>

<style>
  .search-page-wrapper {
    padding-bottom: 60px;
  }

  .page-intro-banner {
    background: linear-gradient(180deg, #F0F6FF 0%, #F7FAFF 100%);
    border-bottom: 1px solid var(--color-border);
    padding: 44px 0 36px 0;
  }

  .banner-badge-wrap {
    display: flex;
    gap: 8px;
    margin-bottom: 14px;
  }

  .page-main-h1 {
    font-size: 2.3rem;
    font-weight: 800;
    color: var(--color-title);
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }

  @media (max-width: 640px) {
    .page-main-h1 {
      font-size: 1.75rem;
    }
  }

  .page-intro-desc {
    font-size: 1.02rem;
    color: var(--color-muted);
    max-width: 820px;
    line-height: 1.7;
    margin-bottom: 24px;
  }

  /* Big Search Bar */
  .page-search-bar-wrap {
    max-width: 780px;
    margin-bottom: 20px;
  }

  .page-search-box {
    display: flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 2px solid rgba(226, 232, 240, 0.9);
    border-radius: var(--radius-full);
    padding: 8px 22px;
    box-shadow: 0 6px 24px rgba(19, 35, 68, 0.06);
    transition: var(--transition-base);
  }

  .page-search-box:focus-within {
    border-color: var(--color-primary);
    box-shadow: 0 8px 28px rgba(40, 92, 240, 0.22);
  }

  .search-svg-icon {
    color: var(--color-primary);
    margin-right: 14px;
    flex-shrink: 0;
  }

  .page-search-input {
    width: 100%;
    border: none;
    outline: none;
    font-size: 1.08rem;
    color: var(--color-title);
    background: transparent;
    padding: 8px 0;
  }

  .page-search-input::placeholder {
    color: var(--color-light-muted);
    font-size: 1rem;
  }

  /* Hot Tags */
  .hot-search-tags-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    font-size: 0.88rem;
  }

  .hot-search-label {
    color: var(--color-muted);
    font-weight: 600;
  }

  .hot-tags-list {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .hot-tag-btn {
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(226, 232, 240, 0.85);
    padding: 4px 12px;
    border-radius: var(--radius-full);
    color: var(--color-body);
    font-size: 0.84rem;
    cursor: pointer;
    transition: var(--transition-base);
  }

  .hot-tag-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-light);
  }

  /* Category Tabs */
  .search-results-container {
    margin-top: 32px;
  }

  .search-tabs-bar {
    display: flex;
    gap: 10px;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 12px;
    margin-bottom: 28px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .search-tab-item {
    background: transparent;
    border: none;
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-muted);
    padding: 6px 14px;
    border-radius: var(--radius-full);
    cursor: pointer;
    transition: var(--transition-base);
    white-space: nowrap;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .search-tab-item:hover {
    color: var(--color-primary);
    background: #F1F5F9;
  }

  .search-tab-item.active {
    background: var(--color-primary);
    color: #FFFFFF;
  }

  .tab-count {
    font-size: 0.78rem;
    background: rgba(0, 0, 0, 0.08);
    padding: 1px 7px;
    border-radius: var(--radius-full);
  }

  .search-tab-item.active .tab-count {
    background: rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
  }

  /* Results List */
  .search-results-list {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .search-result-card {
    padding: 24px;
  }

  .result-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 10px;
    flex-wrap: wrap;
  }

  .result-type-tag.brand {
    background: var(--color-primary-light);
    color: var(--color-primary);
    border: 1px solid var(--color-primary-border);
  }

  .result-type-tag.plan {
    background: #ECFDF5;
    color: #065F46;
    border: 1px solid #A7F3D0;
  }

  .result-type-tag.guide {
    background: #FEF3C7;
    color: #92400E;
    border: 1px solid #FDE68A;
  }

  .result-type-tag.article {
    background: #F3E8FF;
    color: #6B21A8;
    border: 1px solid #E9D5FF;
  }

  .result-type-tag.risk {
    background: #FEE2E2;
    color: #991B1B;
    border: 1px solid #FECACA;
  }

  .result-price-badge {
    background: #10B981;
    color: #FFFFFF;
    font-weight: 700;
  }

  .result-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-title);
    margin-bottom: 4px;
  }

  .result-title-link {
    color: inherit;
    text-decoration: none;
  }

  .result-title-link:hover {
    color: var(--color-primary);
  }

  .result-subtitle {
    font-size: 0.88rem;
    color: var(--color-muted);
    margin-bottom: 10px;
    font-weight: 500;
  }

  .result-snippet {
    font-size: 0.94rem;
    color: var(--color-body);
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .result-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--color-border-light);
    padding-top: 14px;
    flex-wrap: wrap;
  }

  .result-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }

  .result-tag-chip {
    font-size: 0.78rem;
    background: #F1F5F9;
    color: #475569;
    padding: 2px 8px;
    border-radius: 4px;
  }

  .result-jump-btn {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: none;
  }

  .result-jump-btn:hover {
    transform: translateX(3px);
  }

  /* Empty State Card */
  .search-empty-card {
    background: rgba(255, 255, 255, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(226, 232, 240, 0.85);
    border-radius: var(--radius-xl);
    padding: 60px 24px;
    text-align: center;
    max-width: 640px;
    margin: 20px auto;
    box-shadow: 0 4px 20px -2px rgba(19, 35, 68, 0.05);
  }

  .empty-icon-box {
    font-size: 3rem;
    margin-bottom: 16px;
  }

  .empty-title {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-title);
    margin-bottom: 10px;
  }

  .empty-desc {
    font-size: 0.96rem;
    color: var(--color-muted);
    line-height: 1.65;
    margin-bottom: 24px;
  }

  .empty-actions {
    display: flex;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .search-idle-card {
    text-align: center;
    padding: 60px 20px;
    color: var(--color-muted);
    font-size: 0.98rem;
    background: #FFFFFF;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
  }

  .tab-empty-msg {
    text-align: center;
    padding: 40px;
    color: var(--color-muted);
    font-size: 0.94rem;
  }

  /* Global Highlight Style */
  :global(.search-highlight) {
    background: #FEF08A;
    color: #854D0E;
    padding: 1px 4px;
    border-radius: 3px;
    font-weight: 700;
  }
</style>
